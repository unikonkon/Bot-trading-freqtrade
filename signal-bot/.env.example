# ─── บอทสัญญาณ TS (signal-bot/index.ts) ─────────────────────────────────────────
# คัดลอกเป็น signal-bot/.env แล้วแก้ค่า (รันคำสั่งจาก root ของ repo) — .env อยู่ใน .gitignore ห้าม commit

# Telegram: สร้างบอทกับ @BotFather ได้ token · หา chat id ของตัวเองจาก @userinfobot
# เว้นว่างทั้งสองค่า = ปิด Telegram (ข้อความจะพิมพ์ลง log แทน ใช้ทดสอบบนเครื่องได้)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# (ออปชัน) chat id อื่นที่สั่ง /pause /resume ได้ คั่นด้วยจุลภาค
TELEGRAM_ALLOWED_CHAT_IDS=

# บอท: SYMBOL:INTERVAL:STRATEGY คั่นด้วยจุลภาค — ควรตรงกับ pair_strategy_map ของ freqtrade
# strategy: supertrend, cdc_actionzone, ut_bot, cm_macd, rsi, squeeze_momentum, msb_ob,
#           support_resistance, trendlines, smc
BOTS=BTCUSDT:1h:supertrend,ETHUSDT:1h:cdc_actionzone,SOLUSDT:1h:ut_bot,BTCUSDT:4h:cm_macd,ETHUSDT:4h:squeeze_momentum

# (ออปชัน) พารามิเตอร์ต่อกลยุทธ์ เป็น JSON ชื่อเดียวกับ lib/backtest.ts และ config.json ของ freqtrade
# STRATEGY_PARAMS={"supertrend":{"atrPeriod":10,"multiplier":3.0},"ut_bot":{"keyValue":1,"utAtrPeriod":10}}

# จำนวนแท่งที่ดึงมาคำนวณ (300–1000; SMC ต้องการ ≥ 300)
KLINE_LIMIT=500
# รอกี่วินาทีหลังแท่งปิดก่อนดึงข้อมูล (Binance ปิดแท่งช้าได้ 1–3 วินาที)
CLOSE_DELAY_SEC=8
# ส่งสรุปสถานะทุกกี่นาที (0 = ปิด)
HEARTBEAT_MIN=240
# รอบ polling สำหรับ interval 1M ที่คำนวณเวลาปิดไม่ได้
FALLBACK_POLL_SEC=300
# ไฟล์เก็บสถานะ (paused, สัญญาณที่ส่งแล้ว, offset ของ Telegram)
STATE_FILE=./signal-bot/data/signal-bot-state.json
# โซนเวลาที่ใช้แสดงในข้อความ
TZ_DISPLAY=Asia/Bangkok
