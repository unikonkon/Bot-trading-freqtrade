// © LuxAlgo — ต้นฉบับ "Trendlines with Breaks [LuxAlgo]"
// ดัดแปลงให้ BUY/SELL ตรงกับบอท: lib/indicators.ts `trendlinesWithBreaks()` + backtest โหมด "ราคาปิดแท่งสัญญาณ (เดิม)"
//
// ═══ สัญญาณมีแบบเดียว: BUY/SELL สลับกันเสมอ ═══════════════════════════════════════════════
//    ไม่มีป้าย "B" (จุดทะลุดิบ) และไม่ใช่ strategy() จึงไม่มีลูกศรคำสั่งของ Strategy Tester ซ้อน
//    ป้ายชุดเดียวกันใช้ได้ทั้ง 3 แบบการเทรดในตาราง (ดูหัวข้อถัดไป)
//
// ═══ 3 แบบการเทรดจากป้ายชุดเดียวกัน ═══════════════════════════════════════════════════════
//    Long    : BUY เปิด Long · SELL ปิด                  = backtest legacy ของเว็บพอดี (Spot)
//    Short   : SELL เปิด Short · BUY ปิด                 ต้องเทรดบน Futures
//    สองฝั่ง : BUY ปิด Short แล้วเปิด Long · SELL ปิด Long แล้วเปิด Short (ถือตลอดหลังป้ายแรก)
//    • ป้ายสลับ BUY → SELL → BUY เสมอ ไม้ของ "สองฝั่ง" จึงเป็นไม้ Long + ไม้ Short ชุดเดียวกันพอดี
//      และเพราะผลรวมเป็นการบวก % ต่อไม้ (ไม่ทบต้น) ผลของสองฝั่ง = Long + Short ทุกช่วง
//      (Drawdown / Win rate ของสองฝั่งคำนวณจากลำดับไม้รวมจริง ไม่ใช่บวกกัน)
//    • กำไร Short ต่อไม้ = (เข้า − ออก) / เข้า × 100 − 2 × fee · ไม่รวม funding ของ Futures
//
// ═══ ตารางกำไร/ขาดทุนรายช่วง ═══════════════════════════════════════════════════════════
//    ผลของช่วง = equity ตอนนี้ − equity เมื่อต้นช่วง (ย้อนจากแท่งล่าสุด 1 / 7 / 30 / 90 / 365 วัน)
//    equity = ผลรวม % ของไม้ที่ปิดแล้ว + ไม้ที่ถืออยู่คิดที่ราคาปิดของแท่งนั้น (หัก 2 × fee เหมือนเว็บปิดไม้ตอนจบข้อมูล)
//    ไม้ที่ถือข้ามต้นช่วงจึงนับเฉพาะส่วนที่ราคาเปลี่ยนในช่วงนั้น · "ทั้งหมด" ของ Long = ผลรวมของเว็บพอดี
//    "ทั้งหมด" บอกจำนวนวันที่คำนวณได้จริง (แท่งแรกของช่วงทดสอบ → แท่งล่าสุด)
//    ช่วงที่ยาวกว่าข้อมูลจะไม่แสดง (เช่นข้อมูลไม่ถึง 1 ปี ไม่มีแถว 1 ปี) เพราะจะได้ค่าเดียวกับ "ทั้งหมด"
//    แถวเทรด = ไม้ที่ปิดแล้ว + ไม้ที่ถืออยู่
//
// ═══ กฎที่ทำซ้ำจากโค้ดของบอท (ค่าตั้งต้น = กลยุทธ์ `trendlines` บนเว็บ) ═══════════════════════
// 1) Pivot (`pivotEvents`, confirmed = true): high[p] สูงกว่าทุกแท่งใน length แท่งซ้ายและขวาแบบเข้มงวด
//    รู้ผลที่แท่ง p + length และเกิดได้ตั้งแต่ bar_index ≥ 2 × length — เขียนเองแทน ta.pivothigh ให้กฎราคาเท่ากันตรงกับบอท
// 2) Slope = ATR(length) / length × mult หรือ Stdev(close, length) / length × mult
//    ATR ของบอท = Wilder RMA เริ่มด้วย SMA = ta.atr · Stdev แบบ population = ta.stdev ค่าตั้งต้น
// 3) เส้น: แท่งที่ยืนยัน pivot high → upper = ราคา pivot, slope_ph = slope ของแท่งนั้น · แท่งอื่น upper −= slope_ph
// 4) ทะลุ: close > upper (ไม่ใช่ upper − slope × length แบบ LuxAlgo ต้นฉบับ) · ทะลุได้ครั้งเดียวต่อเส้น
// 5) แท่งแรกของข้อมูล: upper เริ่มที่ 0 บอทจึงนับ close > 0 เป็นการทะลุขึ้น → BUY ที่แท่งแรกของกราฟ (ทำตามบอท)
// 6) แท่งเดียวทะลุทั้งสองเส้น: SELL ทับ BUY
// 7) กฎสลับเปิด–ปิด (`alternateSignals`): เก็บเฉพาะจุดทะลุแรกของแต่ละฝั่ง → BUY/SELL สลับกันเสมอ
// 8) Backtest legacy: เริ่มว่างที่ "Backtest From" · เข้า/ออกที่ราคาปิดของแท่งสัญญาณ · ไม่มี slippage
//    ไม้ที่ยังถือตอนจบช่วงนับปิดที่ราคาปิดแท่งสุดท้าย (เฉพาะในตาราง ไม่วาดป้าย เพราะบอทไม่ส่งสัญญาณนี้)
//
// ═══ ข้อควรรู้ก่อนเทียบกับเว็บ ═══════════════════════════════════════════════════════════
//    • ใช้ BINANCE:<คู่เหรียญ> (Spot) ไม่ใช่ perpetual (.P) และตั้ง timezone กราฟเป็นกรุงเทพ
//    • ตั้ง "Backtest From" = แท่งแรกหลังช่วงอุ่นเครื่องของเว็บ (ช่วงที่ผลทดสอบเริ่ม)
//    • ATR ขึ้นกับแท่งแรกของข้อมูล — ถ้ากราฟเริ่มคนละแท่งกับเว็บ สัญญาณต่างได้เฉพาะช่วงต้นกราฟ (วัดแล้วไม่เกิน ~30 แท่ง)
//    • สัญญาณตัดสินเมื่อปิดแท่งเท่านั้น แท่งที่ยังไม่ปิดจะไม่มีป้าย (ตรงกับบอทที่ใช้แท่งปิดแล้ว)

//@version=6
indicator('Trendlines with Breaks [LuxAlgo] — Bot BUY/SELL (Legacy close)', 'TL Breaks Bot Legacy', overlay = true, max_bars_back = 500)

//------------------------------------------------------------------------------
//Settings
//-----------------------------------------------------------------------------{
length     = input.int(14, 'Swing Detection Lookback', minval = 2, maxval = 200, tooltip = 'trendLength ของบอท (ค่าตั้งต้น 14 · เว็บรับ 2–200)')
mult       = input.float(1.0, 'Slope', minval = 0.01, maxval = 20, step = 0.1, tooltip = 'trendMult ของบอท (ค่าตั้งต้น 1.0)')
calcMethod = input.string('Atr', 'Slope Calculation Method', options = ['Atr', 'Stdev'], tooltip = 'บอทใช้ Atr เป็นค่าตั้งต้น และไม่มีโหมด Linreg')

startTime  = input.time(timestamp('01 Jan 2017 00:00 +0700'), 'Backtest From', group = 'Backtest (legacy)', tooltip = 'แท่งแรกของช่วงทดสอบบนเว็บ — เริ่มสถานะว่างที่นี่ ป้าย BUY/SELL มีเฉพาะในช่วงนี้')
endTime    = input.time(timestamp('31 Dec 2099 00:00 +0700'), 'Backtest To', group = 'Backtest (legacy)', tooltip = 'แท่งสุดท้ายของช่วง (เวลาเปิดแท่ง)')
feeInput   = input.float(0.10, 'Fee per side %', minval = 0, maxval = 5, step = 0.01, group = 'Backtest (legacy)', tooltip = 'ค่าธรรมเนียม/ขา เท่ากับช่องบนเว็บ (ค่าตั้งต้น 0.10)')
showTable  = input.bool(true, 'Show P/L table', group = 'Table')
showDetail = input.bool(false, 'Show Drawdown', group = 'Table')
tablePosIn = input.string('Top Right', 'Position', options = ['Top Right', 'Top Left', 'Bottom Right', 'Bottom Left'], group = 'Table', inline = 'tbl')
tableSize  = input.string('Normal', 'Size', options = ['Small', 'Normal', 'Large'], group = 'Table', inline = 'tbl')

upCss      = input.color(color.teal, 'Up Trendline Color', group = 'Style')
dnCss      = input.color(color.red, 'Down Trendline Color', group = 'Style')
showLines  = input.bool(true, 'Show trendlines', group = 'Style')
buyCss     = input.color(#089981, 'BUY', group = 'Style', inline = 'sig')
sellCss    = input.color(#F23645, 'SELL', group = 'Style', inline = 'sig')

//-----------------------------------------------------------------------------}
//Pivots — กฎเดียวกับ pivotEvents(): สูง/ต่ำกว่าเพื่อนบ้านทั้งสองข้างแบบเข้มงวด
//-----------------------------------------------------------------------------{
pivotHighAt(int len) =>
    float result = na
    if bar_index >= 2 * len
        float cand = high[len]
        bool ok = true
        for j = 1 to len
            if cand <= high[len + j] or cand <= high[len - j]
                ok := false
                break
        result := ok ? cand : na
    result

pivotLowAt(int len) =>
    float result = na
    if bar_index >= 2 * len
        float cand = low[len]
        bool ok = true
        for j = 1 to len
            if cand >= low[len + j] or cand >= low[len - j]
                ok := false
                break
        result := ok ? cand : na
    result

//-----------------------------------------------------------------------------}
//Trendlines & breaks — trendlinesWithBreaks()
//-----------------------------------------------------------------------------{
var float upper   = 0.
var float lower   = 0.
var float slopePh = 0.
var float slopePl = 0.
var int   upos    = 0
var int   dnos    = 0
var bool  hasPh   = false
var bool  hasPl   = false

atrV  = ta.atr(length)
stdV  = ta.stdev(close, length)
slope = (calcMethod == 'Stdev' ? nz(stdV) : nz(atrV)) / length * mult

ph   = pivotHighAt(length)
pl   = pivotLowAt(length)
isPh = not na(ph)
isPl = not na(pl)

if isPh
    upper   := ph
    slopePh := slope
    hasPh   := true
else
    upper := upper - slopePh

if isPl
    lower   := pl
    slopePl := slope
    hasPl   := true
else
    lower := lower + slopePl

prevUpos = upos
prevDnos = dnos
upos := isPh ? 0 : close > upper ? 1 : upos
dnos := isPl ? 0 : close < lower ? 1 : dnos

// SELL ทับ BUY ถ้าแท่งเดียวทะลุทั้งสองเส้น · ตัดสินเมื่อปิดแท่งเท่านั้น
rawSig = not barstate.isconfirmed ? 0 : dnos > prevDnos ? -1 : upos > prevUpos ? 1 : 0

//-----------------------------------------------------------------------------}
//Signals — alternateSignals(): BUY/SELL สลับกันเสมอ
//-----------------------------------------------------------------------------{
var int altState = 0
int streamSig = 0
if altState == 0 and rawSig == 1
    streamSig := 1
    altState  := 1
else if altState == 1 and rawSig == -1
    streamSig := -1
    altState  := 0

inWindow      = time >= startTime and time <= endTime
lastWindowBar = time <= endTime and time_close > endTime

// sig = สัญญาณเดียวที่วาดและแจ้งเตือน: 1 BUY · −1 SELL (เฉพาะในช่วง backtest)
int sig = inWindow ? streamSig : 0

// เวลาเปิดของแท่งแรกในช่วงทดสอบ = จุดเริ่มของ "ทั้งหมด"
var int windowStartT = na
if inWindow and na(windowStartT)
    windowStartT := time

//-----------------------------------------------------------------------------}
//Books — บัญชีแยกของแต่ละแบบการเทรด (legacy: ราคาปิดแท่งสัญญาณ, บวก % ไม่ทบต้น)
//-----------------------------------------------------------------------------{
type Book
    int        side               // 1 = Long, −1 = Short (บัญชีรวมไม่ใช้)
    bool       inPos = false
    float      entry = na
    int        n     = 0
    int        wins  = 0
    float      sum   = 0.
    float      peak  = 0.
    float      dd    = 0.
    array<int> exits

// บันทึกไม้ที่ปิด: ผลรวม · ชนะ · drawdown ของผลรวมที่ปิดแล้ว · เวลาปิด (ใช้นับเทรดรายช่วง)
method record(Book b, float pnl) =>
    b.n    := b.n + 1
    b.sum  := b.sum + pnl
    b.wins := b.wins + (pnl > 0 ? 1 : 0)
    b.peak := math.max(b.peak, b.sum)
    b.dd   := math.max(b.dd, b.peak - b.sum)
    b.exits.push(time_close)

// ผล % ของไม้ถ้าปิดที่ราคา px (หัก 2 × fee)
method pnlAt(Book b, float px) =>
    b.inPos ? b.side * (px - b.entry) / b.entry * 100 - 2 * feeInput : 0.

var Book bookL = Book.new(side = 1, exits = array.new<int>())
var Book bookS = Book.new(side = -1, exits = array.new<int>())
var Book bookB = Book.new(side = 0, exits = array.new<int>())   // สองฝั่ง = ไม้ของ Long และ Short เรียงตามเวลา

// ปิดไม้ของบัญชีหนึ่งที่ราคาปิดแท่งนี้ แล้วลงบัญชีสองฝั่งด้วย
closeBook(Book b) =>
    if b.inPos
        float pnl = b.pnlAt(close)
        b.record(pnl)
        bookB.record(pnl)
        b.inPos := false

openBook(Book b) =>
    if not b.inPos
        b.inPos := true
        b.entry := close

if sig == 1
    closeBook(bookS)       // BUY: ปิด Short
    openBook(bookL)        //      เปิด Long
else if sig == -1
    closeBook(bookL)       // SELL: ปิด Long
    openBook(bookS)        //       เปิด Short

// จบช่วงที่ตั้ง "Backtest To": ปิดไม้ค้างที่ราคาปิด (ไม่วาดป้าย) — ไม้ที่เพิ่งเปิดแท่งนี้ก็ปิดทันทีเหมือนเว็บ
if lastWindowBar and barstate.isconfirmed
    closeBook(bookL)
    closeBook(bookS)

//-----------------------------------------------------------------------------}
//Equity รายแท่ง (ใช้หากำไร/ขาดทุนรายช่วง)
//-----------------------------------------------------------------------------{
eqL = bookL.sum + bookL.pnlAt(close)
eqS = bookS.sum + bookS.pnlAt(close)

var array<int>   eqTime = array.new<int>()
var array<float> eqValL = array.new<float>()
var array<float> eqValS = array.new<float>()
if barstate.isconfirmed
    eqTime.push(time_close)
    eqValL.push(eqL)
    eqValS.push(eqS)

// ดัชนีสุดท้ายที่ค่า ≤ t (อาเรย์เรียงจากน้อยไปมาก) · −1 = ไม่มี
lastAtOrBefore(array<int> a, int t) =>
    int lo  = 0
    int hi  = a.size() - 1
    int ans = -1
    while lo <= hi
        int mid = math.floor((lo + hi) / 2)
        if a.get(mid) <= t
            ans := mid
            lo  := mid + 1
        else
            hi  := mid - 1
    ans

//-----------------------------------------------------------------------------}
//Plots
//-----------------------------------------------------------------------------{
plot(showLines and hasPh ? upper : na, 'Upper (down-trendline)', color = isPh ? na : upCss)
plot(showLines and hasPl ? lower : na, 'Lower (up-trendline)', color = isPl ? na : dnCss)

plotshape(sig == 1, 'BUY', shape.labelup, location.belowbar, buyCss, text = 'BUY', textcolor = color.white, size = size.small)
plotshape(sig == -1, 'SELL', shape.labeldown, location.abovebar, sellCss, text = 'SELL', textcolor = color.white, size = size.small)

plot(sig, 'Signal (1 BUY / -1 SELL)', display = display.data_window)

//-----------------------------------------------------------------------------}
//ตารางกำไร/ขาดทุน: แถว = ช่วงเวลา · คอลัมน์ = แบบการเทรด
//-----------------------------------------------------------------------------{
fmtPct(float x) => (x > 0 ? '+' : '') + str.tostring(x, '0.00') + '%'
pnlColor(float x) => x > 0.005 ? buyCss : x < -0.005 ? sellCss : color.gray

if showTable and barstate.islast
    tPos  = tablePosIn == 'Top Left' ? position.top_left : tablePosIn == 'Bottom Right' ? position.bottom_right : tablePosIn == 'Bottom Left' ? position.bottom_left : position.top_right
    tSize = tableSize == 'Small' ? size.small : tableSize == 'Large' ? size.large : size.normal
    bg    = color.new(#131722, 10)
    muted = color.new(color.white, 45)
    band  = color.new(color.white, 92)
    var table t = table.new(tPos, 4, 12, bgcolor = bg, frame_color = color.new(color.white, 85), frame_width = 1)
    table.clear(t, 0, 0, 3, 11)

    // หัวตาราง
    table.cell(t, 0, 0, syminfo.ticker + ' · ' + timeframe.period, text_color = color.white, text_size = tSize, text_halign = text.align_left)
    table.merge_cells(t, 0, 0, 2, 0)
    table.cell(t, 3, 0, 'fee ' + str.tostring(feeInput, '0.00') + '%', text_color = muted, text_size = tSize, text_halign = text.align_right, tooltip = 'ค่าธรรมเนียมต่อขา · ผลเป็นผลรวม % ต่อไม้ (ไม่ทบต้น) แบบเดียวกับเว็บ · ไม่รวม funding')
    table.cell(t, 0, 1, 'ช่วง', text_color = muted, text_size = tSize, text_halign = text.align_left)
    table.cell(t, 1, 1, '▲ Long', text_color = muted, text_size = tSize, text_halign = text.align_right, tooltip = 'BUY เปิด Long · SELL ปิด (Spot) — ตรงกับ backtest ของเว็บ')
    table.cell(t, 2, 1, '▼ Short', text_color = muted, text_size = tSize, text_halign = text.align_right, tooltip = 'SELL เปิด Short · BUY ปิด (ต้องใช้ Futures · ไม่รวม funding)')
    table.cell(t, 3, 1, '⇅ สองฝั่ง', text_color = muted, text_size = tSize, text_halign = text.align_right, tooltip = 'BUY ปิด Short แล้วเปิด Long · SELL ปิด Long แล้วเปิด Short\nไม้ชุดเดียวกับ Long + Short จึงได้ผลรวมเท่ากัน')

    // ระยะเวลาที่คำนวณได้จริง: แท่งแรกของช่วงทดสอบ → แท่งล่าสุด (แท่งที่ยังไม่ปิดนับถึงเวลาปัจจุบัน)
    nowT    = math.min(time_close, timenow)
    fromT   = nz(windowStartT, nowT)
    totalMs = nowT - fromT
    DAY_MS  = 86400000

    // 1 วัน · 1 สัปดาห์ · 1 เดือน · 3 เดือน · 1 ปี — ย้อนจากแท่งล่าสุด · แสดงเฉพาะช่วงที่ข้อมูลยาวพอ
    names = array.from('1 วัน', '1 สัปดาห์', '1 เดือน', '3 เดือน', '1 ปี')
    spans = array.from(1, 7, 30, 90, 365)
    int row = 2
    for i = 0 to 4
        spanMs = spans.get(i) * DAY_MS
        if spanMs <= totalMs
            refT = nowT - spanMs
            idx  = lastAtOrBefore(eqTime, refT)
            chgL = eqL - (idx >= 0 ? eqValL.get(idx) : 0.)
            chgS = eqS - (idx >= 0 ? eqValS.get(idx) : 0.)
            chgB = chgL + chgS
            table.cell(t, 0, row, names.get(i), text_color = color.white, text_size = tSize, text_halign = text.align_left, tooltip = 'ย้อน ' + str.tostring(spans.get(i)) + ' วันจากแท่งล่าสุด')
            table.cell(t, 1, row, fmtPct(chgL), text_color = pnlColor(chgL), text_size = tSize, text_halign = text.align_right)
            table.cell(t, 2, row, fmtPct(chgS), text_color = pnlColor(chgS), text_size = tSize, text_halign = text.align_right)
            table.cell(t, 3, row, fmtPct(chgB), text_color = pnlColor(chgB), text_size = tSize, text_halign = text.align_right)
            row += 1

    // ทั้งหมด + จำนวนวัน (Long = ผลรวมของเว็บ · ไม้ที่ถืออยู่นับปิดที่ราคาล่าสุด)
    eqB      = eqL + eqS
    days     = math.floor(totalMs / DAY_MS)
    allLabel = 'ทั้งหมด · ' + (days >= 1 ? str.tostring(days) + ' วัน' : str.tostring(math.floor(totalMs / 3600000)) + ' ชม.')
    allTip   = str.format_time(fromT, 'dd MMM yyyy HH:mm', 'Asia/Bangkok') + ' → ' + str.format_time(nowT, 'dd MMM yyyy HH:mm', 'Asia/Bangkok') + ' (เวลาไทย)\nเริ่มนับจากแท่งแรกของช่วงทดสอบ (Backtest From หรือแท่งแรกของกราฟ)'
    table.cell(t, 0, row, allLabel, text_color = color.white, text_size = tSize, text_halign = text.align_left, bgcolor = band, tooltip = allTip)
    table.cell(t, 1, row, fmtPct(eqL), text_color = pnlColor(eqL), text_size = tSize, text_halign = text.align_right, bgcolor = band)
    table.cell(t, 2, row, fmtPct(eqS), text_color = pnlColor(eqS), text_size = tSize, text_halign = text.align_right, bgcolor = band)
    table.cell(t, 3, row, fmtPct(eqB), text_color = pnlColor(eqB), text_size = tSize, text_halign = text.align_right, bgcolor = band)
    row += 1

    // จำนวนเทรด (ปิดแล้ว + ถืออยู่)
    nL = bookL.n + (bookL.inPos ? 1 : 0)
    nS = bookS.n + (bookS.inPos ? 1 : 0)
    table.cell(t, 0, row, 'เทรด', text_color = muted, text_size = tSize, text_halign = text.align_left)
    table.cell(t, 1, row, str.tostring(nL), text_color = muted, text_size = tSize, text_halign = text.align_right)
    table.cell(t, 2, row, str.tostring(nS), text_color = muted, text_size = tSize, text_halign = text.align_right)
    table.cell(t, 3, row, str.tostring(nL + nS), text_color = muted, text_size = tSize, text_halign = text.align_right)
    row += 1

    // Win rate (แสดงเสมอ) — ไม้ที่ถืออยู่นับปิดที่ราคาล่าสุดเหมือนเว็บ · สองฝั่ง = ไม้ Long + Short รวมกัน
    openL = bookL.pnlAt(close)
    openS = bookS.pnlAt(close)
    winL  = bookL.wins + (bookL.inPos and openL > 0 ? 1 : 0)
    winS  = bookS.wins + (bookS.inPos and openS > 0 ? 1 : 0)
    table.cell(t, 0, row, 'Win rate', text_color = color.white, text_size = tSize, text_halign = text.align_left, tooltip = 'สัดส่วนไม้ที่กำไรหลังหักค่าธรรมเนียม')
    table.cell(t, 1, row, nL > 0 ? str.tostring(winL * 100.0 / nL, '0.0') + '%' : '—', text_color = color.white, text_size = tSize, text_halign = text.align_right)
    table.cell(t, 2, row, nS > 0 ? str.tostring(winS * 100.0 / nS, '0.0') + '%' : '—', text_color = color.white, text_size = tSize, text_halign = text.align_right)
    table.cell(t, 3, row, nL + nS > 0 ? str.tostring((winL + winS) * 100.0 / (nL + nS), '0.0') + '%' : '—', text_color = color.white, text_size = tSize, text_halign = text.align_right)
    row += 1

    // สถานะ: ป้ายสลับกันเสมอ จึงถือได้ทีละฝั่ง — Long ถือหลัง BUY, Short ถือหลัง SELL, สองฝั่งถือตามป้ายล่าสุด
    status = bookL.inPos ? '▲ ถือ Long · เข้า ' + str.tostring(bookL.entry, format.mintick) + ' · ' + fmtPct(openL) : bookS.inPos ? '▼ ถือ Short · เข้า ' + str.tostring(bookS.entry, format.mintick) + ' · ' + fmtPct(openS) : '○ ว่าง · รอป้ายแรก'
    table.cell(t, 0, row, status, text_color = bookL.inPos ? pnlColor(openL) : bookS.inPos ? pnlColor(openS) : muted, text_size = tSize, text_halign = text.align_left, tooltip = 'Long ถือหลัง BUY · Short ถือหลัง SELL · สองฝั่งถือฝั่งเดียวกับป้ายล่าสุดเสมอ')
    table.merge_cells(t, 0, row, 3, row)
    row += 1

    // Drawdown (ปิดไว้เป็นค่าตั้งต้น) — ไม้ที่ถืออยู่นับปิดที่ราคาล่าสุดเหมือนเว็บ
    if showDetail
        ddL = math.max(bookL.dd, math.max(bookL.peak, eqL) - eqL)
        ddS = math.max(bookS.dd, math.max(bookS.peak, eqS) - eqS)
        ddB = math.max(bookB.dd, math.max(bookB.peak, eqB) - eqB)
        table.cell(t, 0, row, 'Drawdown', text_color = muted, text_size = tSize, text_halign = text.align_left, tooltip = 'ลดลงมากสุดจากจุดสูงสุดของผลรวม % (หน่วยเดียวกับผลรวม)')
        table.cell(t, 1, row, str.tostring(ddL, '0.00') + '%', text_color = muted, text_size = tSize, text_halign = text.align_right)
        table.cell(t, 2, row, str.tostring(ddS, '0.00') + '%', text_color = muted, text_size = tSize, text_halign = text.align_right)
        table.cell(t, 3, row, str.tostring(ddB, '0.00') + '%', text_color = muted, text_size = tSize, text_halign = text.align_right)

//-----------------------------------------------------------------------------}
//Alerts
//-----------------------------------------------------------------------------{
alertcondition(sig == 1, 'BUY', 'BUY {{ticker}} ({{interval}}) | Long เข้า / Short ปิด @ {{close}}')
alertcondition(sig == -1, 'SELL', 'SELL {{ticker}} ({{interval}}) | Long ปิด / Short เข้า @ {{close}}')

if sig == 1
    alert('🟢 BUY ' + syminfo.ticker + ' (' + timeframe.period + ') | Long เข้า / Short ปิด @ ' + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if sig == -1
    alert('🔴 SELL ' + syminfo.ticker + ' (' + timeframe.period + ') | Long ปิด / Short เข้า @ ' + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

//-----------------------------------------------------------------------------}
