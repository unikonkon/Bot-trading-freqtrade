// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © piriya33
// Added Labels and alert conditions and other quality of life feature
// Updated compatability with pine script v4
// Based on improvements from "Kitti-Playbook Action Zone V.4.2.0.3 for Stock Market"
//
// ดัดแปลงให้ BUY/SELL ตรงกับบอท: lib/indicators.ts `cdcActionZone()` + กลยุทธ์ `cdc_actionzone`
// และเพิ่มตารางกำไร/ขาดทุนรายช่วง แบบเดียวกับ "Trendlines with Breaks [LuxAlgo] buysell-legacy.pine"
//
// ═══ สัญญาณ BUY/SELL (ชุดเดียว สลับกันเสมอ) ══════════════════════════════════════════════
//    BUY  = แท่งเขียวแรก (Green และแท่งก่อนหน้าไม่เขียว) ขณะที่แนวโน้มแท่งก่อนหน้าเป็น bearish
//    SELL = แท่งแดงแรก  (Red และแท่งก่อนหน้าไม่แดง)   ขณะที่แนวโน้มแท่งก่อนหน้าเป็น bullish
//    แนวโน้ม = เงื่อนไขไหน (เขียวแรก / แดงแรก) เกิดล่าสุด — แบบเดียวกับบอท
//    • ต้นฉบับใช้ ta.barssince ซึ่งยังไม่มีแนวโน้มจนกว่าจะเกิดครบทั้งสองเงื่อนไข
//      ต่างจากบอทเฉพาะป้ายแรก ๆ ของกราฟ จึงเปลี่ยนให้ตามบอท
//    • ผ่านกฎสลับเปิด–ปิดของบอท (`alternateSignals`): ป้ายแรกต้องเป็น BUY
//    • ตัดสินเมื่อปิดแท่งเท่านั้น แท่งที่ยังไม่ปิดจะไม่มีป้าย (บอทใช้แท่งปิดแล้ว)
//
// ═══ 3 แบบการเทรดจากป้ายชุดเดียวกัน ═══════════════════════════════════════════════════════
//    Long    : BUY เปิด Long · SELL ปิด                  = backtest legacy ของเว็บ (Spot)
//    Short   : SELL เปิด Short · BUY ปิด                 ต้องเทรดบน Futures · ไม่รวม funding
//    สองฝั่ง : BUY ปิด Short แล้วเปิด Long · SELL ปิด Long แล้วเปิด Short
//    ผลเป็นผลรวม % ต่อไม้ (ไม่ทบต้น) หัก 2 × fee ต่อไม้ · เข้า/ออกที่ราคาปิดของแท่งสัญญาณ
//    ป้ายสลับกันเสมอ ผลของสองฝั่งจึง = Long + Short ทุกช่วง
//
// ═══ ตารางกำไร/ขาดทุนรายช่วง ═══════════════════════════════════════════════════════════
//    ผลของช่วง = equity ตอนนี้ − equity เมื่อต้นช่วง (ย้อนจากแท่งล่าสุด 1 / 7 / 30 / 90 / 365 วัน)
//    equity = ผลรวม % ของไม้ที่ปิดแล้ว + ไม้ที่ถืออยู่คิดที่ราคาปิดของแท่งนั้น
//    "ทั้งหมด" บอกจำนวนวันที่คำนวณได้จริง · ช่วงที่ยาวกว่าข้อมูลจะไม่แสดง
//    Win rate = ไม้ที่กำไรหลังหัก fee ÷ ไม้ทั้งหมด (ไม้ที่ถืออยู่นับปิดที่ราคาล่าสุด)
//
// ═══ ข้อควรรู้ก่อนเทียบกับเว็บ ═══════════════════════════════════════════════════════════
//    • ตรงกับบอทเมื่อใช้ค่าตั้งต้น: Source = close · Smoothing = 1 · ปิด Fixed time frame Mode
//      (Fast / Slow EMA ตั้งตาม fastPeriod / slowPeriod บนเว็บได้)
//    • ใช้ BINANCE:<คู่เหรียญ> (Spot) และตั้ง "Backtest From" = แท่งแรกของช่วงทดสอบบนเว็บ

//@version=5
indicator('CDC ActionZone V3 2020', overlay=true, precision=6)
//****************************************************************************//
// CDC Action Zone is based on a simple EMA crossover
// between [default] EMA12 and EMA26
// The zones are defined by the relative position of
// price in relation to the two EMA lines
// Different zones can be use to activate / deactivate
// other trading strategies
// The strategy can also be used on its own with
// acceptable result, buy on the first green candle
// and sell on the first red candle
//****************************************************************************//
//****************************************************************************//
// Define User Input Variables

xsrc = input.source(title='Source Data', defval=close)
xprd1 = input.int(title='Fast EMA period', defval=12)
xprd2 = input.int(title='Slow EMA period', defval=26)
xsmooth = input.int(title='Smoothing period (1 = no smoothing)', defval=1)
fillSW = input.bool(title='Paint Bar Colors', defval=true)
fastSW = input.bool(title='Show fast moving average line', defval=true)
slowSW = input.bool(title='Show slow moving average line', defval=true)
labelSwitch = input.bool(title='Turn on assistive text', defval=true)
plotSigsw = input.bool(title='Plot Buy/Sell Signals? ', defval=true)
plotRibsw = input.bool(title='Plot Buy/Sell Ribbon', defval=false)
plotRibbonPos = input.string(title='Ribbon Position', options=['Top', 'Bottom'], defval='Top')

xfixtf = input.bool(title='** Use Fixed time frame Mode (advanced) **', defval=false)
xtf = input.timeframe(title='** Fix chart to which time frame ? **)', defval='D')

plotSig2sw = input.bool(title='Plot momentum based Buy/Sell Signals? ', defval=false)
plotSig2lv = input.int(title='Set signal threshold (higher = stricter)', defval=1, minval=0, maxval=1)

startTime  = input.time(timestamp('01 Jan 2017 00:00 +0700'), 'Backtest From', group = 'Backtest (legacy)', tooltip = 'แท่งแรกของช่วงทดสอบบนเว็บ — เริ่มสถานะว่างที่นี่ ป้าย BUY/SELL มีเฉพาะในช่วงนี้')
endTime    = input.time(timestamp('31 Dec 2099 00:00 +0700'), 'Backtest To', group = 'Backtest (legacy)', tooltip = 'แท่งสุดท้ายของช่วง (เวลาเปิดแท่ง)')
feeInput   = input.float(0.10, 'Fee per side %', minval = 0, maxval = 5, step = 0.01, group = 'Backtest (legacy)', tooltip = 'ค่าธรรมเนียม/ขา เท่ากับช่องบนเว็บ (ค่าตั้งต้น 0.10)')
showTable  = input.bool(true, 'Show P/L table', group = 'Table')
showDetail = input.bool(false, 'Show Drawdown', group = 'Table')
tablePosIn = input.string('Top Right', 'Position', options = ['Top Right', 'Top Left', 'Bottom Right', 'Bottom Left'], group = 'Table', inline = 'tbl')
tableSize  = input.string('Normal', 'Size', options = ['Small', 'Normal', 'Large'], group = 'Table', inline = 'tbl')
buyCss     = input.color(#089981, 'BUY', group = 'Table', inline = 'sig')
sellCss    = input.color(#F23645, 'SELL', group = 'Table', inline = 'sig')

//****************************************************************************//
//Calculate Indicators

f_secureSecurity(_symbol, _res, _src) => request.security(_symbol, _res, _src[1], lookahead = barmerge.lookahead_on) // Using f_secureSecurity to avoid repainting

xPrice = ta.ema(xsrc, xsmooth)


FastMA = xfixtf ?
 ta.ema(f_secureSecurity(syminfo.tickerid, xtf, ta.ema(xsrc, xprd1)), xsmooth)
 :
 ta.ema(xPrice, xprd1)


SlowMA = xfixtf ?
 ta.ema(f_secureSecurity(syminfo.tickerid, xtf, ta.ema(xsrc, xprd2)), xsmooth)
 :
 ta.ema(xPrice, xprd2)

Bull = FastMA > SlowMA
Bear = FastMA < SlowMA

//****************************************************************************//
// Define Color Zones

Green = Bull and xPrice > FastMA  // Buy
Blue = Bear and xPrice > FastMA and xPrice > SlowMA  //Pre Buy 2
LBlue = Bear and xPrice > FastMA and xPrice < SlowMA  //Pre Buy 1

Red = Bear and xPrice < FastMA  // Sell
Orange = Bull and xPrice < FastMA and xPrice < SlowMA  // Pre Sell 2
Yellow = Bull and xPrice < FastMA and xPrice > SlowMA  // Pre Sell 1

//****************************************************************************//
// Display color on chart


bColor = Green ? color.green :
 Blue ? color.blue :
 LBlue ? color.aqua :
 Red ? color.red :
 Orange ? color.orange :
 Yellow ? color.yellow :
 color.black
barcolor(color=fillSW ? bColor : na)

//****************************************************************************//
// Display MA lines

FastL = plot(fastSW ? FastMA : na, 'Fast EMA', color=color.new(color.red, 0), style = xfixtf ? plot.style_stepline : plot.style_line)
SlowL = plot(slowSW ? SlowMA : na, 'Slow EMA', color=color.new(color.blue, 0), style = xfixtf ? plot.style_stepline : plot.style_line)
fillcolor = Bull ? color.new(color.green,90) : Bear ? color.new(color.red,90) : color.new(color.black,90) // fillcolor = Bull ? color.green : Bear ? color.red : color.black
fill(FastL, SlowL, fillcolor) // fill(FastL, SlowL, fillcolor, transp=90)

//****************************************************************************//
// Define Buy and Sell condition
// This is only for thebasic usage of CDC Actionzone (EMA Crossover)
// ie. Buy on first green bar and sell on first red bar

buycond = Green and Green[1] == 0
sellcond = Red and Red[1] == 0

// แนวโน้มแบบบอท: เงื่อนไขไหนเกิดล่าสุด (ต้นฉบับใช้ ta.barssince ซึ่งเป็น na จนกว่าจะเกิดครบทั้งสองเงื่อนไข)
var int lastBuyBar  = na
var int lastSellBar = na
if buycond
    lastBuyBar := bar_index
if sellcond
    lastSellBar := bar_index

bullish = not na(lastBuyBar) and (na(lastSellBar) or lastBuyBar > lastSellBar)
bearish = not na(lastSellBar) and (na(lastBuyBar) or lastSellBar > lastBuyBar)

buy = bearish[1] and buycond
sell = bullish[1] and sellcond

bColor_BullBear = bullish ? color.green : bearish ? color.red : color.black

//****************************************************************************//
// Signals — alternateSignals(): BUY/SELL สลับกันเสมอ · ตัดสินเมื่อปิดแท่ง

rawSig = not barstate.isconfirmed ? 0 : buy ? 1 : sell ? -1 : 0

var int altState = 0
int streamSig = 0
if altState == 0 and rawSig == 1
    streamSig := 1
    altState  := 1
else if altState == 1 and rawSig == -1
    streamSig := -1
    altState  := 0

inWindow      = time >= startTime and time <= endTime
lastWindowBar = time <= endTime and time_close > endTime

// sig = สัญญาณเดียวที่วาดและแจ้งเตือน: 1 BUY · −1 SELL (เฉพาะในช่วง backtest)
int sig = inWindow ? streamSig : 0

// เวลาเปิดของแท่งแรกในช่วงทดสอบ = จุดเริ่มของ "ทั้งหมด"
var int windowStartT = na
if inWindow and na(windowStartT)
    windowStartT := time

//****************************************************************************//
// Books — บัญชีแยกของแต่ละแบบการเทรด (legacy: ราคาปิดแท่งสัญญาณ, บวก % ไม่ทบต้น)

type Book
    int   side               // 1 = Long, −1 = Short (บัญชีรวมไม่ใช้)
    bool  inPos = false
    float entry = na
    int   n     = 0
    int   wins  = 0
    float sum   = 0.
    float peak  = 0.
    float dd    = 0.

// บันทึกไม้ที่ปิด: ผลรวม · ชนะ · drawdown ของผลรวมที่ปิดแล้ว
method record(Book b, float pnl) =>
    b.n    := b.n + 1
    b.sum  := b.sum + pnl
    b.wins := b.wins + (pnl > 0 ? 1 : 0)
    b.peak := math.max(b.peak, b.sum)
    b.dd   := math.max(b.dd, b.peak - b.sum)

// ผล % ของไม้ถ้าปิดที่ราคา px (หัก 2 × fee)
method pnlAt(Book b, float px) =>
    b.inPos ? b.side * (px - b.entry) / b.entry * 100 - 2 * feeInput : 0.

var Book bookL = Book.new(side = 1)
var Book bookS = Book.new(side = -1)
var Book bookB = Book.new(side = 0)   // สองฝั่ง = ไม้ของ Long และ Short เรียงตามเวลา

// ปิดไม้ของบัญชีหนึ่งที่ราคาปิดแท่งนี้ แล้วลงบัญชีสองฝั่งด้วย
closeBook(Book b) =>
    if b.inPos
        float pnl = b.pnlAt(close)
        b.record(pnl)
        bookB.record(pnl)
        b.inPos := false

openBook(Book b) =>
    if not b.inPos
        b.inPos := true
        b.entry := close

if sig == 1
    closeBook(bookS)       // BUY: ปิด Short
    openBook(bookL)        //      เปิด Long
else if sig == -1
    closeBook(bookL)       // SELL: ปิด Long
    openBook(bookS)        //       เปิด Short

// จบช่วงที่ตั้ง "Backtest To": ปิดไม้ค้างที่ราคาปิด (ไม่วาดป้าย) — ไม้ที่เพิ่งเปิดแท่งนี้ก็ปิดทันทีเหมือนเว็บ
if lastWindowBar and barstate.isconfirmed
    closeBook(bookL)
    closeBook(bookS)

// Equity รายแท่ง (ใช้หากำไร/ขาดทุนรายช่วง)
eqL = bookL.sum + bookL.pnlAt(close)
eqS = bookS.sum + bookS.pnlAt(close)

var array<int>   eqTime = array.new<int>()
var array<float> eqValL = array.new<float>()
var array<float> eqValS = array.new<float>()
if barstate.isconfirmed
    eqTime.push(time_close)
    eqValL.push(eqL)
    eqValS.push(eqS)

// ดัชนีสุดท้ายที่ค่า ≤ t (อาเรย์เรียงจากน้อยไปมาก) · −1 = ไม่มี
lastAtOrBefore(array<int> a, int t) =>
    int lo  = 0
    int hi  = a.size() - 1
    int ans = -1
    while lo <= hi
        int mid = math.floor((lo + hi) / 2)
        if a.get(mid) <= t
            ans := mid
            lo  := mid + 1
        else
            hi  := mid - 1
    ans

//****************************************************************************//
// Plot Buy and Sell point on chart

plotshape(plotSigsw and sig == 1, 'Buy Signal', shape.labelup, location.belowbar, buyCss, text = 'BUY', textcolor = color.white, size = size.small)
plotshape(plotSigsw and sig == -1, 'Sell Signal', shape.labeldown, location.abovebar, sellCss, text = 'SELL', textcolor = color.white, size = size.small)
plot(sig, 'Signal (1 BUY / -1 SELL)', display = display.data_window)

// Display Buy/Sell Ribbon


plotshape(plotRibsw ? plotRibbonPos == 'Top' ? close : na : na,
 style=shape.square,
 title='Buy/Sell Ribbon',
 location=location.top,
 color=bColor_BullBear)

plotshape(plotRibsw ? plotRibbonPos == 'Bottom' ? close : na : na,
 style=shape.square,
 title='Buy/Sell Ribbon',
 location=location.bottom,
 color=bColor_BullBear)


//****************************************************************************//
// Label

labelstyle = close > SlowMA ? label.style_label_down : label.style_label_up
labelyloc = close > SlowMA ? yloc.abovebar : yloc.belowbar
labeltcolor = sig == 1 ? color.black :
 sig == -1 ? color.white :
 close > close[1] ? color.green :
 color.red
labelbgcolor = sig == 1 ? color.green : sig == -1 ? color.red : color.silver
labeltext = sig == 1 ? 'BUY\n' : sig == -1 ? 'SELL\n' : ' '
trendText = bullish ? 'bullish' : bearish ? 'bearish' : 'sideways'


l1 = label.new(bar_index, na,
 text=labeltext + syminfo.ticker + ' ' + str.tostring(close) + ' ' + syminfo.currency + '\n currently in a ' + trendText + ' trend \n',
 color=labelbgcolor,
 textcolor=labeltcolor,
 yloc=labelyloc,
 style=labelstyle)

label.delete(labelSwitch ? l1[1] : l1)

// Momentum Signal using StochRSI

// Adds a momentum based signal following trends to the script
// Default is hidden, only use with caution
// Parameters for STOCH RSI is hard-coded to avoid cluttering the input screen further
// If you need to change anything, make a copy of the code and change it.
// Inputs are commented out, to enable them comment out the hard coded variables first!

// fixed inputs //

smoothK = 3
smoothD = 3
RSIlen = 14
STOlen = 14
SRsrc = close
OSlevel = 30
OBlevel = 70

// User inputs // // COMMENT ABOVE VARIABLES FIRST!!

// smoothK = input(3,"StochRSI smooth K",type=input.integer,minval=1)
// smoothD = input(3,"StochRSI smooth D",type=input.integer,minval=1)
// RSIlen = input(14,"RSI length",type=input.integer,minval=1)
// STOlen = input(14,"Stochastic length",type=input.integer,minval=1)
// SRsrc = input(close,"Source for StochasticRSI",type=input.source)
// OSlevel = input(30,"Oversold Threshold",type=input.float,minval=0.00)
// OBlevel = input(70,"Oversold Threshold",type=input.float,minval=0.00)

// calculations //
rsi1 = ta.rsi(SRsrc, RSIlen)
k = ta.sma(ta.stoch(rsi1, rsi1, rsi1, STOlen), smoothK)
d = ta.sma(k, smoothD)

// storsiBuySig =  if bullish
//     if (d < OSlevel and crossover(k,d))
//         3
//     else if crossover(k,OSlevel)
//         2
//     else if d > OSlevel and crossover(k,d)
//         1
//     else
//         0
// else
//     0

crossover_1 = ta.crossover(k, d)
crossover_2 = ta.crossover(k, d)
iff_1 = d > OSlevel and crossover_2 ?
 1 : 0
iff_2 = d < OSlevel and crossover_1 ?
 2 : iff_1
storsiBuySig = bullish ? iff_2 : 0

crossunder_1 = ta.crossunder(k, d)
crossunder_2 = ta.crossunder(k, d)
iff_3 = d < OBlevel and crossunder_2 ?
 1 : 0
iff_4 = d > OBlevel and crossunder_1 ?
 2 : iff_3
storsiSellSig = bearish ? iff_4 : 0

plotshape(plotSig2sw ? storsiBuySig > plotSig2lv ? storsiBuySig : na : na,
 'Buy more signals', style=shape.triangleup,
  location=location.belowbar, color=color.new(color.teal, 0))
plotshape(plotSig2sw ? storsiSellSig > plotSig2lv ? storsiSellSig : na : na,
 'Sell more signals', style=shape.triangledown,
  location=location.abovebar, color=color.new(color.orange, 0))


//****************************************************************************//
// ตารางกำไร/ขาดทุน: แถว = ช่วงเวลา · คอลัมน์ = แบบการเทรด

fmtPct(float x) => (x > 0 ? '+' : '') + str.tostring(x, '0.00') + '%'
pnlColor(float x) => x > 0.005 ? buyCss : x < -0.005 ? sellCss : color.gray

if showTable and barstate.islast
    tPos  = tablePosIn == 'Top Left' ? position.top_left : tablePosIn == 'Bottom Right' ? position.bottom_right : tablePosIn == 'Bottom Left' ? position.bottom_left : position.top_right
    tSize = tableSize == 'Small' ? size.small : tableSize == 'Large' ? size.large : size.normal
    bg    = color.new(#131722, 10)
    muted = color.new(color.white, 45)
    band  = color.new(color.white, 92)
    var table t = table.new(tPos, 4, 12, bgcolor = bg, frame_color = color.new(color.white, 85), frame_width = 1)
    table.clear(t, 0, 0, 3, 11)

    // หัวตาราง
    table.cell(t, 0, 0, 'CDC · ' + syminfo.ticker + ' · ' + timeframe.period, text_color = color.white, text_size = tSize, text_halign = text.align_left)
    table.merge_cells(t, 0, 0, 2, 0)
    table.cell(t, 3, 0, 'fee ' + str.tostring(feeInput, '0.00') + '%', text_color = muted, text_size = tSize, text_halign = text.align_right, tooltip = 'ค่าธรรมเนียมต่อขา · ผลเป็นผลรวม % ต่อไม้ (ไม่ทบต้น) แบบเดียวกับเว็บ · ไม่รวม funding')
    table.cell(t, 0, 1, 'ช่วง', text_color = muted, text_size = tSize, text_halign = text.align_left)
    table.cell(t, 1, 1, '▲ Long', text_color = muted, text_size = tSize, text_halign = text.align_right, tooltip = 'BUY เปิด Long · SELL ปิด (Spot) — ตรงกับ backtest ของเว็บ')
    table.cell(t, 2, 1, '▼ Short', text_color = muted, text_size = tSize, text_halign = text.align_right, tooltip = 'SELL เปิด Short · BUY ปิด (ต้องใช้ Futures · ไม่รวม funding)')
    table.cell(t, 3, 1, '⇅ สองฝั่ง', text_color = muted, text_size = tSize, text_halign = text.align_right, tooltip = 'BUY ปิด Short แล้วเปิด Long · SELL ปิด Long แล้วเปิด Short\nไม้ชุดเดียวกับ Long + Short จึงได้ผลรวมเท่ากัน')

    // ระยะเวลาที่คำนวณได้จริง: แท่งแรกของช่วงทดสอบ → แท่งล่าสุด (แท่งที่ยังไม่ปิดนับถึงเวลาปัจจุบัน)
    nowT    = math.min(time_close, timenow)
    fromT   = nz(windowStartT, nowT)
    totalMs = nowT - fromT
    DAY_MS  = 86400000

    // 1 วัน · 1 สัปดาห์ · 1 เดือน · 3 เดือน · 1 ปี — ย้อนจากแท่งล่าสุด · แสดงเฉพาะช่วงที่ข้อมูลยาวพอ
    names = array.from('1 วัน', '1 สัปดาห์', '1 เดือน', '3 เดือน', '1 ปี')
    spans = array.from(1, 7, 30, 90, 365)
    int row = 2
    for i = 0 to 4
        spanMs = spans.get(i) * DAY_MS
        if spanMs <= totalMs
            refT = nowT - spanMs
            idx  = lastAtOrBefore(eqTime, refT)
            chgL = eqL - (idx >= 0 ? eqValL.get(idx) : 0.)
            chgS = eqS - (idx >= 0 ? eqValS.get(idx) : 0.)
            chgB = chgL + chgS
            table.cell(t, 0, row, names.get(i), text_color = color.white, text_size = tSize, text_halign = text.align_left, tooltip = 'ย้อน ' + str.tostring(spans.get(i)) + ' วันจากแท่งล่าสุด')
            table.cell(t, 1, row, fmtPct(chgL), text_color = pnlColor(chgL), text_size = tSize, text_halign = text.align_right)
            table.cell(t, 2, row, fmtPct(chgS), text_color = pnlColor(chgS), text_size = tSize, text_halign = text.align_right)
            table.cell(t, 3, row, fmtPct(chgB), text_color = pnlColor(chgB), text_size = tSize, text_halign = text.align_right)
            row += 1

    // ทั้งหมด + จำนวนวัน (Long = ผลรวมของเว็บ · ไม้ที่ถืออยู่นับปิดที่ราคาล่าสุด)
    eqB      = eqL + eqS
    days     = math.floor(totalMs / DAY_MS)
    allLabel = 'ทั้งหมด · ' + (days >= 1 ? str.tostring(days) + ' วัน' : str.tostring(math.floor(totalMs / 3600000)) + ' ชม.')
    allTip   = str.format_time(fromT, 'dd MMM yyyy HH:mm', 'Asia/Bangkok') + ' → ' + str.format_time(nowT, 'dd MMM yyyy HH:mm', 'Asia/Bangkok') + ' (เวลาไทย)\nเริ่มนับจากแท่งแรกของช่วงทดสอบ (Backtest From หรือแท่งแรกของกราฟ)'
    table.cell(t, 0, row, allLabel, text_color = color.white, text_size = tSize, text_halign = text.align_left, bgcolor = band, tooltip = allTip)
    table.cell(t, 1, row, fmtPct(eqL), text_color = pnlColor(eqL), text_size = tSize, text_halign = text.align_right, bgcolor = band)
    table.cell(t, 2, row, fmtPct(eqS), text_color = pnlColor(eqS), text_size = tSize, text_halign = text.align_right, bgcolor = band)
    table.cell(t, 3, row, fmtPct(eqB), text_color = pnlColor(eqB), text_size = tSize, text_halign = text.align_right, bgcolor = band)
    row += 1

    // จำนวนเทรด (ปิดแล้ว + ถืออยู่)
    nL = bookL.n + (bookL.inPos ? 1 : 0)
    nS = bookS.n + (bookS.inPos ? 1 : 0)
    table.cell(t, 0, row, 'เทรด', text_color = muted, text_size = tSize, text_halign = text.align_left)
    table.cell(t, 1, row, str.tostring(nL), text_color = muted, text_size = tSize, text_halign = text.align_right)
    table.cell(t, 2, row, str.tostring(nS), text_color = muted, text_size = tSize, text_halign = text.align_right)
    table.cell(t, 3, row, str.tostring(nL + nS), text_color = muted, text_size = tSize, text_halign = text.align_right)
    row += 1

    // Win rate — ไม้ที่ถืออยู่นับปิดที่ราคาล่าสุดเหมือนเว็บ · สองฝั่ง = ไม้ Long + Short รวมกัน
    openL = bookL.pnlAt(close)
    openS = bookS.pnlAt(close)
    winL  = bookL.wins + (bookL.inPos and openL > 0 ? 1 : 0)
    winS  = bookS.wins + (bookS.inPos and openS > 0 ? 1 : 0)
    table.cell(t, 0, row, 'Win rate', text_color = color.white, text_size = tSize, text_halign = text.align_left, tooltip = 'สัดส่วนไม้ที่กำไรหลังหักค่าธรรมเนียม')
    table.cell(t, 1, row, nL > 0 ? str.tostring(winL * 100.0 / nL, '0.0') + '%' : '—', text_color = color.white, text_size = tSize, text_halign = text.align_right)
    table.cell(t, 2, row, nS > 0 ? str.tostring(winS * 100.0 / nS, '0.0') + '%' : '—', text_color = color.white, text_size = tSize, text_halign = text.align_right)
    table.cell(t, 3, row, nL + nS > 0 ? str.tostring((winL + winS) * 100.0 / (nL + nS), '0.0') + '%' : '—', text_color = color.white, text_size = tSize, text_halign = text.align_right)
    row += 1

    // สถานะ: ป้ายสลับกันเสมอ จึงถือได้ทีละฝั่ง
    status = bookL.inPos ? '▲ ถือ Long · เข้า ' + str.tostring(bookL.entry, format.mintick) + ' · ' + fmtPct(openL) : bookS.inPos ? '▼ ถือ Short · เข้า ' + str.tostring(bookS.entry, format.mintick) + ' · ' + fmtPct(openS) : '○ ว่าง · รอป้ายแรก'
    table.cell(t, 0, row, status, text_color = bookL.inPos ? pnlColor(openL) : bookS.inPos ? pnlColor(openS) : muted, text_size = tSize, text_halign = text.align_left, tooltip = 'Long ถือหลัง BUY · Short ถือหลัง SELL · สองฝั่งถือฝั่งเดียวกับป้ายล่าสุดเสมอ')
    table.merge_cells(t, 0, row, 3, row)
    row += 1

    // Drawdown (ปิดไว้เป็นค่าตั้งต้น) — ไม้ที่ถืออยู่นับปิดที่ราคาล่าสุดเหมือนเว็บ
    if showDetail
        ddL = math.max(bookL.dd, math.max(bookL.peak, eqL) - eqL)
        ddS = math.max(bookS.dd, math.max(bookS.peak, eqS) - eqS)
        ddB = math.max(bookB.dd, math.max(bookB.peak, eqB) - eqB)
        table.cell(t, 0, row, 'Drawdown', text_color = muted, text_size = tSize, text_halign = text.align_left, tooltip = 'ลดลงมากสุดจากจุดสูงสุดของผลรวม % (หน่วยเดียวกับผลรวม)')
        table.cell(t, 1, row, str.tostring(ddL, '0.00') + '%', text_color = muted, text_size = tSize, text_halign = text.align_right)
        table.cell(t, 2, row, str.tostring(ddS, '0.00') + '%', text_color = muted, text_size = tSize, text_halign = text.align_right)
        table.cell(t, 3, row, str.tostring(ddB, '0.00') + '%', text_color = muted, text_size = tSize, text_halign = text.align_right)


//****************************************************************************//
// Alert conditions

alertcondition(sig == 1,
 title='*Buy Alert',
 message='Buy {{exchange}}:{{ticker}} | Long เข้า / Short ปิด @ {{close}}')

alertcondition(sig == -1,
 title='*Sell Alert',
 message='Sell {{exchange}}:{{ticker}} | Long ปิด / Short เข้า @ {{close}}')

alertcondition(bullish,
 title='is Bullish')

alertcondition(bearish,
 title='is Bearish')

alertcondition(Green,
 title='is Green')

alertcondition(Blue,
 title='is Blue (Strong Rally)')

alertcondition(LBlue,
 title='is Light Blue (Rally)')

alertcondition(Red,
 title='is Red')

alertcondition(Orange,
 title='is Orange (Strong Dip)')

alertcondition(Yellow,
 title='is Yellow (Dip)')

if sig == 1
    alert('🟢 BUY ' + syminfo.ticker + ' (' + timeframe.period + ') | Long เข้า / Short ปิด @ ' + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if sig == -1
    alert('🔴 SELL ' + syminfo.ticker + ' (' + timeframe.period + ') | Long ปิด / Short เข้า @ ' + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)


//****************************************************************************//
