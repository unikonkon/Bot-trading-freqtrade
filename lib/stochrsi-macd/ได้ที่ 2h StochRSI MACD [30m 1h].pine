// This work is licensed under a Attribution-NonCommercial-ShareAlike 4.0 International (CC BY-NC-SA 4.0) https://creativecommons.org/licenses/by-nc-sa/4.0/
// StochRSI + MACD — ป้าย BUY/SELL สำหรับกราฟ 30m / 1h · กฎออก · ตาราง · แจ้งเตือน ชุดเดียวกับ "Trendlines with Breaks [LuxAlgo] buysell-rsi.pine"
// ตารางมีแถว "เทียบ: rsi.pine" = ป้ายเส้นเทรนด์ของ rsi.pine (กฎออก Auto) บนกราฟเดียวกัน ช่วงเดียวกัน → เห็นทันทีว่าดีกว่าหรือไม่บนเหรียญที่เปิด
//
// ═══ หลักการ ═══════════════════════════════════════════════════════════════════════════════
//    StochRSI = Stochastic ของ RSI(14) ช่วง 14 · K = SMA 3 · D = SMA 3 ของ K (เหมือน indicator มาตรฐานของ TradingView)
//    MACD 12 / 26 / 9 · histogram = MACD − Signal
//    BUY  = K ตัดขึ้นผ่านระดับล่าง (ออกจากโซนขายมากเกิน) และ histogram > 0 (โมเมนตัมขาขึ้นยืนยัน)
//    SELL = K ตัดลงผ่านระดับบน (ออกจากโซนซื้อมากเกิน) และ histogram < 0
//    (แบบ "K×D ในโซน" = K ตัด D ขณะอยู่ในโซน แทนการตัดระดับ)
//    ตัดสินที่ราคาปิดแท่งของ TF ป้าย · เข้าที่ราคาปิด · ไม่บังคับสลับ: BUY ปิด Short แล้วเปิด Long ถ้ายังไม่ถือ (SELL กลับกัน)
//    TF ป้ายสูงกว่ากราฟ (เช่น 1h บนกราฟ 30m): คำนวณบนแท่ง 1h ที่ปิดแล้ว (request.security · lookahead ปิด) ไม่ repaint
//    กฎออก TP / SL / Trail ตาม EMA200 · ATR(14) ของกราฟ = ตาราง Auto ของ rsi.pine ทุกอย่าง
//
// ═══ ค่า Auto (เลือกจากงานทดสอบด้านล่าง) ═══════════════════════════════════════════════════════
//    กราฟต่ำกว่า 1h (ทดสอบที่ 30m)   ป้ายจากแท่ง 1h · K ตัด 30 / 70 + MACD hist
//    กราฟ 1h ขึ้นไป (ทดสอบที่ 1h)    ป้ายจากแท่งกราฟ · K ตัด 20 / 80 + MACD hist
//    ไม่กรองเทรนด์ 1D · กฎออก Auto ตาม TF ของกราฟ (Long: ตามป้าย · Short: TP 8 SL 3 / TP 5 SL 2 ตาม EMA200)
//    TF อื่น (15m, 4h, 1D) ใช้ค่าของกลุ่มที่ครอบอยู่ แต่ไม่ได้ทดสอบ
//
// ═══ ผลทดสอบ (สคริปต์จำลองกฎเดียวกัน · 63 เหรียญ Binance · fee 0.10%/ขา · SL slip 0.05%) ═════════════════
//    ตัวชี้วัด = median ต่อเหรียญของผลรวม % ต่อไม้ (หน่วยเดียวกับตาราง) · Δ = แบบนี้ − rsi.pine บนเหรียญเดียวกัน · (%) = เหรียญที่ดีขึ้น
//    วิธีเลือก: ~4,000 แบบ (StochRSI 30 แบบป้าย × กฎออก 9 × ตัวกรองเทรนด์ 7 · รอบ 2 ปรับระดับ/ความยาว · รอบ 3 ป้ายจาก TF สูง)
//      เลือกจาก 60% แรกของชุดหลัก (15 เหรียญ) เท่านั้น · กติกาตั้งก่อนดูผล: ไม้ ≥ 1/4 ของ rsi.pine แล้วเอา Δ สูงสุด
//      แล้วตรวจที่ 40% หลังของชุดหลัก + ชุดตรวจอีก 3–4 ชุด (ทั้งช่วง ~21 เดือน · ชุดสุดท้ายของ 1h ยาวกว่า)
//                    ช่วงตรวจของชุดหลัก         ชุดตรวจ 1 / 2 / 3 / 5 (ทั้งช่วง)
//      1h  สองฝั่ง   +37.8 vs +4.5  Δ +42 (80%)   +65 / −28 / +33 / −14   vs rsi.pine +10 / −64 / −13 / −80
//          Long      +20.9 vs −4.5  Δ +26 (67%)   Δ +22 / −6 / +60 / +21
//          Short     +17.6 vs −4.5  Δ +20 (67%)   Δ +30 / +13 / +43 / +12
//      30m สองฝั่ง   +30.9 vs −6.8  Δ +43 (73%)   +35 / −59 / −86         vs rsi.pine −78 / −180 / −174
//          Long      +12.2 vs −10.9 Δ +29 (80%)   Δ +56 / +84 / +90
//          Short     +13.7 vs +0.1  Δ +11 (67%)   Δ +33 / +37 / +44
//    ข้อควรรู้
//    • ชนะ rsi.pine ทุกชุดเป็นส่วนใหญ่เพราะเทรดน้อยกว่า ~3 เท่า (ป้ายผิดน้อยลง เสีย fee น้อยลง) ไม่ใช่กำไรต่อไม้สูงขึ้นมาก
//    • ผลจริงยังติดลบในบางชุด (1h: 2 จาก 4 ชุด · 30m: 2 จาก 3 ชุด) → ดีกว่า rsi.pine ไม่ได้แปลว่ากำไรเสมอ
//    • BTC 1h: +103.7 vs rsi.pine +111.1 (แพ้เล็กน้อย) · ETH 1h +157 vs −31 · SOL 1h +178 vs +69 · BTC 30m −32.8 vs −38.9
//    • ป้ายจาก StochRSI/MACD ล้วน ๆ บนแท่ง 30m แพ้ rsi.pine ในช่วงเลือก → ที่ 30m จึงใช้ป้ายจากแท่ง 1h
//    • การกรองด้วยเทรนด์ 1D EMA50 / MACD 4h ไม่ชนะในช่วงเลือกเมื่อบังคับไม้ขั้นต่ำ → Auto ไม่กรอง (เลือกเองได้)
//    • ข้อมูลทุกชุดเคยใช้ในงานวิจัยอื่นมาก่อน ผลเป็นตัวประกอบ ไม่ใช่ข้อพิสูจน์ · ผลย้อนหลังไม่รับประกันอนาคต
//
// ═══ ใช้งานจริง ═══════════════════════════════════════════════════════════════════════════
//    • "ป้าย/แจ้งเตือนของ" เลือก Long / Short / สองฝั่ง · ตารางแสดงทั้ง 3 แบบเสมอ
//    • แจ้งเตือน BUY/SELL บอกราคาเข้า TP / SL ของไม้ใหม่ · TS ตัดสินที่ราคาปิด
//    • ใช้ BINANCE:<คู่เหรียญ> · Short ต้องใช้ Futures และไม่รวม funding

//@version=6
indicator('StochRSI + MACD — Bot BUY/SELL (30m · 1h · เทียบ rsi.pine)', 'SRSI MACD', overlay = true, max_bars_back = 500)

//------------------------------------------------------------------------------
//Settings
//-----------------------------------------------------------------------------{
preset     = input.string('Auto (ตาม TF)', 'ค่าป้าย', options = ['Auto (ตาม TF)', 'กำหนดเอง'], group = 'ป้าย StochRSI + MACD', tooltip = 'Auto: กราฟ < 1h → ป้ายจากแท่ง 1h · K ตัด 30/70 + MACD\nกราฟ ≥ 1h → ป้ายจากแท่งกราฟ · K ตัด 20/80 + MACD\nกำหนดเอง = ใช้ช่องด้านล่าง')
sigModeIn  = input.string('K ตัดระดับ', 'แบบป้าย', options = ['K ตัดระดับ', 'K×D ในโซน'], group = 'ป้าย StochRSI + MACD', tooltip = 'K ตัดระดับ: K ตัดขึ้นผ่านระดับล่าง = BUY · ตัดลงผ่านระดับบน = SELL\nK×D ในโซน: K ตัดขึ้น D ขณะต่ำกว่าระดับล่าง = BUY · ตัดลงขณะสูงกว่าระดับบน = SELL')
loIn       = input.float(20, 'ระดับล่าง', minval = 1, maxval = 99, step = 5, group = 'ป้าย StochRSI + MACD', inline = 'lv')
hiIn       = input.float(80, 'บน', minval = 1, maxval = 99, step = 5, group = 'ป้าย StochRSI + MACD', inline = 'lv')
confIn     = input.bool(true, 'ต้องมี MACD histogram ยืนยัน', group = 'ป้าย StochRSI + MACD', tooltip = 'BUY ต้อง histogram > 0 · SELL ต้อง histogram < 0')
sigTfIn    = input.timeframe('', 'TF ของป้าย', group = 'ป้าย StochRSI + MACD', tooltip = 'ว่าง = TF กราฟ · ต้องสูงกว่ากราฟ (ต่ำกว่าหรือเท่ากับ = ใช้ TF กราฟ)\nคำนวณบนแท่ง TF นี้ที่ปิดแล้ว ไม่ repaint')
biasIn     = input.string('ไม่กรอง', 'กรองเทรนด์ 1D', options = ['ไม่กรอง', '1D EMA50'], group = 'ป้าย StochRSI + MACD', tooltip = '1D EMA50: เปิด Long เฉพาะวันที่ปิดเหนือ EMA50 ของวันก่อน · Short กลับกัน (ป้ายตรงข้ามยังปิดไม้ได้)\nAuto ไม่กรอง')
rsiLen     = input.int(14, 'RSI', minval = 2, maxval = 200, group = 'ความยาว', inline = 's1')
stLen      = input.int(14, 'Stoch', minval = 2, maxval = 200, group = 'ความยาว', inline = 's1')
kSm        = input.int(3, 'K', minval = 1, maxval = 50, group = 'ความยาว', inline = 's2')
dSm        = input.int(3, 'D', minval = 1, maxval = 50, group = 'ความยาว', inline = 's2')
mFast      = input.int(12, 'MACD fast', minval = 1, maxval = 200, group = 'ความยาว', inline = 'm1')
mSlow      = input.int(26, 'slow', minval = 2, maxval = 400, group = 'ความยาว', inline = 'm1')
mSigLen    = input.int(9, 'signal', minval = 1, maxval = 100, group = 'ความยาว', inline = 'm1')

showMode   = input.string('สองฝั่ง', 'ป้าย/แจ้งเตือนของ', options = ['สองฝั่ง', 'Long', 'Short'], group = 'แบบการเทรด', tooltip = 'เลือกว่าจะวาดป้ายและส่งแจ้งเตือนของแบบไหน · ตารางแสดง Long / Short / สองฝั่งเสมอ\nLong = BUY เปิด · SELL ปิด (Spot)\nShort = SELL เปิด · BUY ปิด (Futures)\nสองฝั่ง = ทั้งคู่')

startTime  = input.time(timestamp('01 Jan 2017 00:00 +0700'), 'Backtest From', group = 'Backtest')
endTime    = input.time(timestamp('31 Dec 2099 00:00 +0700'), 'Backtest To', group = 'Backtest')
feeInput   = input.float(0.10, 'Fee per side %', minval = 0, maxval = 5, step = 0.01, group = 'Backtest')

exitMode   = input.string('Auto (ตาม TF)', 'Exit preset', options = ['Auto (ตาม TF)', 'Manual', 'ตามป้ายอย่างเดียว'], group = 'Exit by EMA trend', tooltip = 'Auto = ตารางเดียวกับ rsi.pine ตาม TF ของกราฟ\nManual = ใช้ช่องด้านล่าง · 0 = ไม่ใช้\nแถวเทียบ rsi.pine ใช้ Auto เสมอ')
trendLen   = input.int(200, 'Trend EMA length', minval = 2, maxval = 1000, group = 'Exit by EMA trend')
slipInput  = input.float(0.05, 'SL slippage %', minval = 0, maxval = 2, step = 0.01, group = 'Exit by EMA trend')
lwTp       = input.float(0.0, 'Long ตามเทรนด์ · TP', minval = 0, maxval = 50, step = 0.5, group = 'Manual (× ATR · 0 = ไม่ใช้)', inline = 'lw')
lwSl       = input.float(0.0, 'SL', minval = 0, maxval = 50, step = 0.5, group = 'Manual (× ATR · 0 = ไม่ใช้)', inline = 'lw')
lwTs       = input.float(0.0, 'Trail', minval = 0, maxval = 50, step = 0.5, group = 'Manual (× ATR · 0 = ไม่ใช้)', inline = 'lw')
lcTp       = input.float(0.0, 'Long สวนเทรนด์ · TP', minval = 0, maxval = 50, step = 0.5, group = 'Manual (× ATR · 0 = ไม่ใช้)', inline = 'lc')
lcSl       = input.float(0.0, 'SL', minval = 0, maxval = 50, step = 0.5, group = 'Manual (× ATR · 0 = ไม่ใช้)', inline = 'lc')
lcTs       = input.float(0.0, 'Trail', minval = 0, maxval = 50, step = 0.5, group = 'Manual (× ATR · 0 = ไม่ใช้)', inline = 'lc')
swTp       = input.float(8.0, 'Short ตามเทรนด์ · TP', minval = 0, maxval = 50, step = 0.5, group = 'Manual (× ATR · 0 = ไม่ใช้)', inline = 'sw')
swSl       = input.float(3.0, 'SL', minval = 0, maxval = 50, step = 0.5, group = 'Manual (× ATR · 0 = ไม่ใช้)', inline = 'sw')
swTs       = input.float(0.0, 'Trail', minval = 0, maxval = 50, step = 0.5, group = 'Manual (× ATR · 0 = ไม่ใช้)', inline = 'sw')
scTp       = input.float(5.0, 'Short สวนเทรนด์ · TP', minval = 0, maxval = 50, step = 0.5, group = 'Manual (× ATR · 0 = ไม่ใช้)', inline = 'sc')
scSl       = input.float(2.0, 'SL', minval = 0, maxval = 50, step = 0.5, group = 'Manual (× ATR · 0 = ไม่ใช้)', inline = 'sc')
scTs       = input.float(0.0, 'Trail', minval = 0, maxval = 50, step = 0.5, group = 'Manual (× ATR · 0 = ไม่ใช้)', inline = 'sc', tooltip = 'ค่าตั้งต้นของ Manual = ค่า Auto ของ TF 1h')

showTable  = input.bool(true, 'Show P/L table', group = 'Table')
showDetail = input.bool(true, 'Show Drawdown', group = 'Table')
tablePosIn = input.string('Top Right', 'Position', options = ['Top Right', 'Top Left', 'Bottom Right', 'Bottom Left'], group = 'Table', inline = 'tbl')
tableSize  = input.string('Normal', 'Size', options = ['Small', 'Normal', 'Large'], group = 'Table', inline = 'tbl')

showEma    = input.bool(true, 'Show trend EMA', group = 'Style')
showLevels = input.bool(true, 'Show TP / SL / TS levels', group = 'Style')
showTl     = input.bool(false, 'แสดงป้าย rsi.pine (จุดเล็ก)', group = 'Style')
buyCss     = input.color(#089981, 'BUY', group = 'Style', inline = 'sig')
sellCss    = input.color(#F23645, 'SELL', group = 'Style', inline = 'sig')

//-----------------------------------------------------------------------------}
//ค่าที่ใช้จริง (Auto / กำหนดเอง)
//-----------------------------------------------------------------------------{
tfSec   = timeframe.in_seconds()
autoGrp = tfSec < 3600 ? 0 : tfSec < 14400 ? 1 : tfSec < 86400 ? 2 : 3
useAuto = preset == 'Auto (ตาม TF)'
modeV   = useAuto ? 0 : sigModeIn == 'K ตัดระดับ' ? 0 : 1
loV     = useAuto ? (autoGrp == 0 ? 30. : 20.) : loIn
hiV     = useAuto ? (autoGrp == 0 ? 70. : 80.) : hiIn
confV   = useAuto ? true : confIn
biasOn  = not useAuto and biasIn == '1D EMA50'
tfWant  = useAuto ? (autoGrp == 0 ? '60' : '') : sigTfIn
sigTf   = tfWant == '' ? timeframe.period : timeframe.in_seconds(tfWant) <= tfSec ? timeframe.period : tfWant
sigIsChart = sigTf == timeframe.period

//-----------------------------------------------------------------------------}
//StochRSI + MACD (คำนวณบนแท่งของ TF ป้าย)
//-----------------------------------------------------------------------------{
srCalc(int mode, float lo, float hi, bool conf) =>
    float r  = ta.rsi(close, rsiLen)
    float k  = ta.sma(ta.stoch(r, r, r, stLen), kSm)
    float d  = ta.sma(k, dSm)
    [m, s, h] = ta.macd(close, mFast, mSlow, mSigLen)
    bool lvB = ta.crossover(k, lo)
    bool lvS = ta.crossunder(k, hi)
    bool kdB = ta.crossover(k, d) and math.min(k, d) < lo
    bool kdS = ta.crossunder(k, d) and math.max(k, d) > hi
    bool b   = mode == 0 ? lvB : kdB
    bool sl  = mode == 0 ? lvS : kdS
    if conf
        b  := b and h > 0
        sl := sl and h < 0
    int raw = sl ? -1 : b ? 1 : 0
    [raw, k, d, h]

[rawH, kH, dH, hH] = request.security(syminfo.tickerid, sigTf, srCalc(modeV, loV, hiV, confV), lookahead = barmerge.lookahead_off)
// แท่งกราฟที่ปิดพร้อมแท่ง TF ป้าย → ค่าเป็นของแท่ง TF ป้ายที่ปิดแล้ว
htfBar = sigIsChart or time_close == time_close(sigTf)

// เทรนด์ 1D: วันก่อนปิดเหนือ / ใต้ EMA50 (ค่าของวันที่ปิดแล้ว)
dTrend() =>
    float e = ta.ema(close, 50)
    int v = na(e) ? 0 : close > e ? 1 : -1
    v[1]
dBias = nz(request.security(syminfo.tickerid, 'D', dTrend(), lookahead = barmerge.lookahead_on))
biasOk(int side) => not biasOn or dBias == side

inWindow      = time >= startTime and time <= endTime
lastWindowBar = time <= endTime and time_close > endTime
int sig = inWindow and barstate.isconfirmed and htfBar ? nz(rawH) : 0

var int windowStartT = na
if inWindow and na(windowStartT)
    windowStartT := time

//-----------------------------------------------------------------------------}
//rsi.pine — เส้นเทรนด์ LuxAlgo + กฎสลับ (ใช้ในแถวเทียบ · โค้ดเดียวกับ rsi.pine)
//-----------------------------------------------------------------------------{
tlLen = 14
pivotHighAt(int len) =>
    float result = na
    if bar_index >= 2 * len
        float cand = high[len]
        bool ok = true
        for j = 1 to len
            if cand <= high[len + j] or cand <= high[len - j]
                ok := false
                break
        result := ok ? cand : na
    result

pivotLowAt(int len) =>
    float result = na
    if bar_index >= 2 * len
        float cand = low[len]
        bool ok = true
        for j = 1 to len
            if cand >= low[len + j] or cand >= low[len - j]
                ok := false
                break
        result := ok ? cand : na
    result

var float upper   = 0.
var float lower   = 0.
var float slopePh = 0.
var float slopePl = 0.
var int   upos    = 0
var int   dnos    = 0

atrV  = ta.atr(14)
slope = nz(atrV) / tlLen
ph    = pivotHighAt(tlLen)
pl    = pivotLowAt(tlLen)
isPh  = not na(ph)
isPl  = not na(pl)
if isPh
    upper   := ph
    slopePh := slope
else
    upper := upper - slopePh
if isPl
    lower   := pl
    slopePl := slope
else
    lower := lower + slopePl
prevUpos = upos
prevDnos = dnos
upos := isPh ? 0 : close > upper ? 1 : upos
dnos := isPl ? 0 : close < lower ? 1 : dnos
tlRaw = not barstate.isconfirmed ? 0 : dnos > prevDnos ? -1 : upos > prevUpos ? 1 : 0
var int altState = 0
int tlSig = 0
if altState == 0 and tlRaw == 1
    tlSig    := 1
    altState := 1
else if altState == 1 and tlRaw == -1
    tlSig    := -1
    altState := 0
int sigO = inWindow ? tlSig : 0

//-----------------------------------------------------------------------------}
//Trend EMA + กฎออก (เหมือน rsi.pine)
//-----------------------------------------------------------------------------{
emaSeed = ta.sma(close, trendLen)
var float emaT = na
alphaT  = 2.0 / (trendLen + 1)
emaT := na(emaT) ? emaSeed : close * alphaT + emaT * (1 - alphaT)
trendDir = na(emaT) ? 0 : close > emaT ? 1 : -1

// [TP, SL, Trail] × ATR ตามฝั่ง และตาม/สวนเทรนด์ ณ แท่งเข้า · forceAuto = แถวเทียบ rsi.pine
exitProfile(int side, bool withTrend, bool forceAuto) =>
    float tp = 0.
    float sl = 0.
    float ts = 0.
    string em = forceAuto ? 'Auto (ตาม TF)' : exitMode
    if em == 'Manual'
        tp := side == 1 ? (withTrend ? lwTp : lcTp) : (withTrend ? swTp : scTp)
        sl := side == 1 ? (withTrend ? lwSl : lcSl) : (withTrend ? swSl : scSl)
        ts := side == 1 ? (withTrend ? lwTs : lcTs) : (withTrend ? swTs : scTs)
    else if em == 'Auto (ตาม TF)'
        if side == 1
            if autoGrp >= 2
                ts := withTrend ? 6. : 0.
                sl := withTrend ? 0. : 3.
        else
            bool wide = withTrend or autoGrp == 0 or autoGrp == 3
            tp := wide ? 8. : 5.
            sl := wide ? 3. : 2.
    [tp, sl, ts]

profileTxt(int side, bool withTrend) =>
    [tp, sl, ts] = exitProfile(side, withTrend, false)
    string s = (tp > 0 ? 'TP ' + str.tostring(tp) + ' ' : '') + (sl > 0 ? 'SL ' + str.tostring(sl) + ' ' : '') + (ts > 0 ? 'Trail ' + str.tostring(ts) + ' ' : '')
    s == '' ? 'ตามป้าย' : s + '× ATR'

//-----------------------------------------------------------------------------}
//Books — ผลรวม % ต่อไม้ (ไม่ทบต้น) เหมือน rsi.pine
//-----------------------------------------------------------------------------{
type Book
    int        side
    int        grp   = 0          // 0 = StochRSI + MACD · 1 = rsi.pine (แถวเทียบ)
    bool       inPos = false
    float      entry = na
    bool       withT = false
    float      tp    = na
    float      sl    = na
    float      trail = 0.
    float      peakC = na
    float      xPx   = na
    int        n     = 0
    int        wins  = 0
    int        nTp   = 0
    int        nSl   = 0
    int        nTs   = 0
    float      sum   = 0.
    float      peak  = 0.
    float      dd    = 0.

method record(Book b, float pnl, bool win) =>
    b.n    := b.n + 1
    b.sum  := b.sum + pnl
    b.wins := b.wins + (win ? 1 : 0)
    b.peak := math.max(b.peak, b.sum)
    b.dd   := math.max(b.dd, b.peak - b.sum)
    b.n

method pnlAt(Book b, float px) =>
    b.inPos ? b.side * (px - b.entry) / b.entry * 100 - 2 * feeInput : 0.

method priceWin(Book b, float px) =>
    b.inPos and b.side * (px - b.entry) > 0

var Book bookL = Book.new(side = 1)
var Book bookS = Book.new(side = -1)
var Book bookB = Book.new(side = 0)
var Book othL  = Book.new(side = 1, grp = 1)
var Book othS  = Book.new(side = -1, grp = 1)
var Book othB  = Book.new(side = 0, grp = 1)

// ปิดไม้ที่ราคา px · คืน true ถ้ามีไม้ถูกปิด
closeBookAt(Book b, float px) =>
    bool did = false
    if b.inPos
        float pnl = b.pnlAt(px)
        bool  win = b.priceWin(px)
        b.record(pnl, win)
        if b.grp == 0
            bookB.record(pnl, win)
        else
            othB.record(pnl, win)
        b.inPos := false
        did := true
    did

// เปิดไม้ที่ราคาปิด · กฎออกกำหนดครั้งเดียวจากเทรนด์ ณ แท่งนี้ · TP/SL เริ่มทำงานแท่งถัดไป · คืน true ถ้าเปิด
openBook(Book b) =>
    bool did = false
    if not b.inPos and not na(atrV)
        bool withTrend = trendDir == b.side
        [tpM, slM, tsM] = exitProfile(b.side, withTrend, b.grp == 1)
        b.inPos := true
        b.entry := close
        b.withT := withTrend
        b.tp    := tpM > 0 ? close + b.side * tpM * atrV : na
        b.sl    := slM > 0 ? close - b.side * slM * atrV : na
        b.trail := tsM
        b.peakC := close
        did := true
    did

// TP / SL ที่ค้างจากแท่งก่อน (ราคาเปิดกระโดดข้ามก่อน · แตะทั้งคู่นับ SL) · คืน 1 TP · −1 SL · 0
exitOrders(Book b) =>
    int hit = 0
    if b.inPos
        float slip    = slipInput / 100
        float adverse = b.side == 1 ? low : high
        float favor   = b.side == 1 ? high : low
        float px      = na
        if not na(b.sl) and b.side * (open - b.sl) <= 0
            hit := -1
            px  := open * (1 - b.side * slip)
        else if not na(b.tp) and b.side * (open - b.tp) >= 0
            hit := 1
            px  := open
        else if not na(b.sl) and b.side * (adverse - b.sl) <= 0
            hit := -1
            px  := b.sl * (1 - b.side * slip)
        else if not na(b.tp) and b.side * (favor - b.tp) >= 0
            hit := 1
            px  := b.tp
        if hit != 0
            closeBookAt(b, px)
            b.xPx := px
            if hit == 1
                b.nTp := b.nTp + 1
            else
                b.nSl := b.nSl + 1
    hit

// Trail ที่ราคาปิด · คืน 2 = TS
exitTrail(Book b) =>
    int hit = 0
    if b.inPos and b.trail > 0
        b.peakC := b.side == 1 ? math.max(b.peakC, close) : math.min(b.peakC, close)
        if b.side * (close - b.peakC) < -b.trail * atrV
            hit := 2
            closeBookAt(b, close)
            b.xPx := close
            b.nTs := b.nTs + 1
    hit

// ลำดับในแท่ง: TP/SL → Trail → ป้าย
int xL = barstate.isconfirmed ? exitOrders(bookL) : 0
int xS = barstate.isconfirmed ? exitOrders(bookS) : 0
if barstate.isconfirmed and xL == 0
    xL := exitTrail(bookL)
if barstate.isconfirmed and xS == 0
    xS := exitTrail(bookS)

// ป้าย StochRSI + MACD (ไม่บังคับสลับ): BUY ปิด Short แล้วเปิด Long ถ้ายังไม่ถือ · SELL กลับกัน
bool openedL = false
bool openedS = false
bool closedL = false
bool closedS = false
if sig == 1
    closedS := closeBookAt(bookS, close)
    if biasOk(1)
        openedL := openBook(bookL)
else if sig == -1
    closedL := closeBookAt(bookL, close)
    if biasOk(-1)
        openedS := openBook(bookS)

// rsi.pine (แถวเทียบ): ลำดับเดียวกัน · ป้ายสลับ · กฎออก Auto
int oxL = barstate.isconfirmed ? exitOrders(othL) : 0
int oxS = barstate.isconfirmed ? exitOrders(othS) : 0
if barstate.isconfirmed and oxL == 0
    oxL := exitTrail(othL)
if barstate.isconfirmed and oxS == 0
    oxS := exitTrail(othS)
if sigO == 1
    closeBookAt(othS, close)
    openBook(othL)
else if sigO == -1
    closeBookAt(othL, close)
    openBook(othS)

if lastWindowBar and barstate.isconfirmed
    closeBookAt(bookL, close)
    closeBookAt(bookS, close)
    closeBookAt(othL, close)
    closeBookAt(othS, close)

//-----------------------------------------------------------------------------}
//Equity รายแท่ง (กำไรรายช่วง)
//-----------------------------------------------------------------------------{
eqL = bookL.sum + bookL.pnlAt(close)
eqS = bookS.sum + bookS.pnlAt(close)
oEqL = othL.sum + othL.pnlAt(close)
oEqS = othS.sum + othS.pnlAt(close)

var array<int>   eqTime = array.new<int>()
var array<float> eqValL = array.new<float>()
var array<float> eqValS = array.new<float>()
var array<float> eqValO = array.new<float>()
if barstate.isconfirmed
    eqTime.push(time_close)
    eqValL.push(eqL)
    eqValS.push(eqS)
    eqValO.push(oEqL + oEqS)

lastAtOrBefore(array<int> a, int t) =>
    int lo  = 0
    int hi  = a.size() - 1
    int ans = -1
    while lo <= hi
        int mid = math.floor((lo + hi) / 2)
        if a.get(mid) <= t
            ans := mid
            lo  := mid + 1
        else
            hi  := mid - 1
    ans

//-----------------------------------------------------------------------------}
//Plots
//-----------------------------------------------------------------------------{
showL = showMode != 'Short'
showS = showMode != 'Long'
buyMark  = sig == 1 and ((showL and openedL) or (showS and closedS))
sellMark = sig == -1 and ((showS and openedS) or (showL and closedL))

plot(showEma ? emaT : na, 'Trend EMA', color = color.new(color.gray, 20), linewidth = 2)
plotshape(buyMark, 'BUY', shape.labelup, location.belowbar, buyCss, text = 'BUY', textcolor = color.white, size = size.small)
plotshape(sellMark, 'SELL', shape.labeldown, location.abovebar, sellCss, text = 'SELL', textcolor = color.white, size = size.small)
plotshape(showTl and sigO == 1, 'BUY rsi.pine', shape.circle, location.belowbar, color.new(buyCss, 40), size = size.tiny)
plotshape(showTl and sigO == -1, 'SELL rsi.pine', shape.circle, location.abovebar, color.new(sellCss, 40), size = size.tiny)

trailLvl(Book b) => b.inPos and b.trail > 0 ? b.peakC - b.side * b.trail * atrV : na
plot(showLevels and showL and bookL.inPos ? bookL.tp : na, 'Long TP level', color = color.new(buyCss, 40), style = plot.style_linebr)
plot(showLevels and showL and bookL.inPos ? bookL.sl : na, 'Long SL level', color = color.new(sellCss, 40), style = plot.style_linebr)
plot(showLevels and showL ? trailLvl(bookL) : na, 'Long Trail level', color = color.new(color.orange, 40), style = plot.style_linebr)
plot(showLevels and showS and bookS.inPos ? bookS.tp : na, 'Short TP level', color = color.new(buyCss, 40), style = plot.style_linebr)
plot(showLevels and showS and bookS.inPos ? bookS.sl : na, 'Short SL level', color = color.new(sellCss, 40), style = plot.style_linebr)
plot(showLevels and showS ? trailLvl(bookS) : na, 'Short Trail level', color = color.new(color.orange, 40), style = plot.style_linebr)

plotshape(showL and xL == 1, 'Long TP', shape.labeldown, location.abovebar, color.new(buyCss, 35), text = 'TP', textcolor = color.white, size = size.tiny)
plotshape(showL and xL == -1, 'Long SL', shape.labeldown, location.abovebar, color.new(sellCss, 35), text = 'SL', textcolor = color.white, size = size.tiny)
plotshape(showL and xL == 2, 'Long TS', shape.labeldown, location.abovebar, color.new(color.orange, 35), text = 'TS', textcolor = color.white, size = size.tiny)
plotshape(showS and xS == 1, 'Short TP', shape.labelup, location.belowbar, color.new(buyCss, 35), text = 'TP', textcolor = color.white, size = size.tiny)
plotshape(showS and xS == -1, 'Short SL', shape.labelup, location.belowbar, color.new(sellCss, 35), text = 'SL', textcolor = color.white, size = size.tiny)
plotshape(showS and xS == 2, 'Short TS', shape.labelup, location.belowbar, color.new(color.orange, 35), text = 'TS', textcolor = color.white, size = size.tiny)

plot(kH, 'StochRSI K (TF ป้าย)', display = display.data_window)
plot(dH, 'StochRSI D (TF ป้าย)', display = display.data_window)
plot(hH, 'MACD hist (TF ป้าย)', display = display.data_window)
plot(sig, 'Signal (1 BUY / -1 SELL)', display = display.data_window)

//-----------------------------------------------------------------------------}
//ตาราง: แถว = ช่วงเวลา · คอลัมน์ = Long / Short / สองฝั่ง
//-----------------------------------------------------------------------------{
fmtPct(float x) => (x > 0 ? '+' : '') + str.tostring(x, '0.00') + '%'
pnlColor(float x) => x > 0.005 ? buyCss : x < -0.005 ? sellCss : color.gray
levelTxt(Book b) => (b.withT ? ' (ตามเทรนด์)' : ' (สวนเทรนด์)') + (na(b.tp) ? '' : ' · TP ' + str.tostring(b.tp, format.mintick)) + (na(b.sl) ? '' : ' · SL ' + str.tostring(b.sl, format.mintick)) + (b.trail > 0 ? ' · TS ' + str.tostring(trailLvl(b), format.mintick) : '')
xTxt(int a, int b, int c) => 'TP ' + str.tostring(a) + ' · SL ' + str.tostring(b) + ' · TS ' + str.tostring(c)
wrTxt(int w, int n) => n > 0 ? str.tostring(w * 100.0 / n, '0.0') + '%' : '—'

if showTable and barstate.islast
    tPos  = tablePosIn == 'Top Left' ? position.top_left : tablePosIn == 'Bottom Right' ? position.bottom_right : tablePosIn == 'Bottom Left' ? position.bottom_left : position.top_right
    tSize = tableSize == 'Small' ? size.small : tableSize == 'Large' ? size.large : size.normal
    bg    = color.new(#131722, 10)
    muted = color.new(color.white, 45)
    band  = color.new(color.white, 92)
    var table t = table.new(tPos, 4, 20, bgcolor = bg, frame_color = color.new(color.white, 85), frame_width = 1)
    table.clear(t, 0, 0, 3, 19)
    sigTxt = (modeV == 0 ? 'K ตัด ' : 'K×D โซน ') + str.tostring(loV, '#') + '/' + str.tostring(hiV, '#') + (confV ? ' + MACD' : '') + ' · ป้าย ' + (sigIsChart ? 'TF กราฟ' : sigTf) + (biasOn ? ' · 1D EMA50' : '')
    exTxt  = exitMode == 'Manual' ? 'Manual' : exitMode == 'ตามป้ายอย่างเดียว' ? 'ตามป้าย' : 'Auto'

    table.cell(t, 0, 0, syminfo.ticker + ' · ' + timeframe.period + ' · StochRSI + MACD · ' + (useAuto ? 'Auto' : 'กำหนดเอง'), text_color = color.white, text_size = tSize, text_halign = text.align_left, tooltip = sigTxt + '\nกฎออก ' + exTxt + ' · Long ตามเทรนด์: ' + profileTxt(1, true) + ' · สวน: ' + profileTxt(1, false) + '\nShort ตามเทรนด์: ' + profileTxt(-1, true) + ' · สวน: ' + profileTxt(-1, false))
    table.merge_cells(t, 0, 0, 2, 0)
    table.cell(t, 3, 0, 'fee ' + str.tostring(feeInput, '0.00') + '%', text_color = muted, text_size = tSize, text_halign = text.align_right, tooltip = 'ผลรวม % ต่อไม้ (ไม่ทบต้น) หัก fee 2 ขา · ไม่รวม funding')
    table.cell(t, 0, 1, sigTxt, text_color = muted, text_size = tSize, text_halign = text.align_left)
    table.merge_cells(t, 0, 1, 3, 1)
    table.cell(t, 0, 2, 'ช่วง', text_color = muted, text_size = tSize, text_halign = text.align_left)
    table.cell(t, 1, 2, '▲ Long', text_color = showL ? color.white : muted, text_size = tSize, text_halign = text.align_right, tooltip = 'BUY เปิด Long · SELL ปิด (Spot)')
    table.cell(t, 2, 2, '▼ Short', text_color = showS ? color.white : muted, text_size = tSize, text_halign = text.align_right, tooltip = 'SELL เปิด Short · BUY ปิด (Futures)')
    table.cell(t, 3, 2, '⇅ สองฝั่ง', text_color = showMode == 'สองฝั่ง' ? color.white : muted, text_size = tSize, text_halign = text.align_right, tooltip = 'Long + Short พร้อมกัน')

    nowT    = math.min(time_close, timenow)
    fromT   = nz(windowStartT, nowT)
    totalMs = nowT - fromT
    DAY_MS  = 86400000
    names = array.from('1 วัน', '1 สัปดาห์', '1 เดือน', '3 เดือน', '6 เดือน', '1 ปี')
    spans = array.from(1, 7, 30, 90, 180, 365)
    int row = 3
    for i = 0 to 5
        spanMs = spans.get(i) * DAY_MS
        if spanMs <= totalMs
            idx  = lastAtOrBefore(eqTime, nowT - spanMs)
            chgL = eqL - (idx >= 0 ? eqValL.get(idx) : 0.)
            chgS = eqS - (idx >= 0 ? eqValS.get(idx) : 0.)
            chgO = oEqL + oEqS - (idx >= 0 ? eqValO.get(idx) : 0.)
            table.cell(t, 0, row, names.get(i), text_color = color.white, text_size = tSize, text_halign = text.align_left, tooltip = 'rsi.pine ช่วงเดียวกัน (สองฝั่ง): ' + fmtPct(chgO))
            table.cell(t, 1, row, fmtPct(chgL), text_color = pnlColor(chgL), text_size = tSize, text_halign = text.align_right)
            table.cell(t, 2, row, fmtPct(chgS), text_color = pnlColor(chgS), text_size = tSize, text_halign = text.align_right)
            table.cell(t, 3, row, fmtPct(chgL + chgS), text_color = pnlColor(chgL + chgS), text_size = tSize, text_halign = text.align_right, tooltip = 'rsi.pine ช่วงเดียวกัน: ' + fmtPct(chgO))
            row += 1

    eqB      = eqL + eqS
    days     = math.floor(totalMs / DAY_MS)
    allLabel = 'ทั้งหมด · ' + (days >= 1 ? str.tostring(days) + ' วัน' : str.tostring(math.floor(totalMs / 3600000)) + ' ชม.')
    allTip   = str.format_time(fromT, 'dd MMM yyyy HH:mm', 'Asia/Bangkok') + ' → ' + str.format_time(nowT, 'dd MMM yyyy HH:mm', 'Asia/Bangkok') + ' (เวลาไทย)'
    table.cell(t, 0, row, allLabel, text_color = color.white, text_size = tSize, text_halign = text.align_left, bgcolor = band, tooltip = allTip)
    table.cell(t, 1, row, fmtPct(eqL), text_color = pnlColor(eqL), text_size = tSize, text_halign = text.align_right, bgcolor = band)
    table.cell(t, 2, row, fmtPct(eqS), text_color = pnlColor(eqS), text_size = tSize, text_halign = text.align_right, bgcolor = band)
    table.cell(t, 3, row, fmtPct(eqB), text_color = pnlColor(eqB), text_size = tSize, text_halign = text.align_right, bgcolor = band)
    row += 1

    // เทียบ rsi.pine (ทั้งหมด) + ส่วนต่าง
    oEqB = oEqL + oEqS
    oTip = 'rsi.pine: ป้ายเส้นเทรนด์ LuxAlgo (length 14 · สลับ BUY/SELL) · กฎออก Auto · ช่วงเดียวกัน fee เดียวกัน'
    table.cell(t, 0, row, 'เทียบ: rsi.pine', text_color = muted, text_size = tSize, text_halign = text.align_left, tooltip = oTip)
    table.cell(t, 1, row, fmtPct(oEqL), text_color = pnlColor(oEqL), text_size = tSize, text_halign = text.align_right, tooltip = oTip)
    table.cell(t, 2, row, fmtPct(oEqS), text_color = pnlColor(oEqS), text_size = tSize, text_halign = text.align_right, tooltip = oTip)
    table.cell(t, 3, row, fmtPct(oEqB), text_color = pnlColor(oEqB), text_size = tSize, text_halign = text.align_right, tooltip = oTip)
    row += 1
    dfL = eqL - oEqL
    dfS = eqS - oEqS
    dfB = eqB - oEqB
    dTip = 'StochRSI + MACD − rsi.pine (ทั้งหมด) · บวก = ไฟล์นี้ดีกว่า'
    table.cell(t, 0, row, 'ส่วนต่าง', text_color = color.white, text_size = tSize, text_halign = text.align_left, tooltip = dTip)
    table.cell(t, 1, row, fmtPct(dfL), text_color = pnlColor(dfL), text_size = tSize, text_halign = text.align_right, tooltip = dTip)
    table.cell(t, 2, row, fmtPct(dfS), text_color = pnlColor(dfS), text_size = tSize, text_halign = text.align_right, tooltip = dTip)
    table.cell(t, 3, row, fmtPct(dfB), text_color = pnlColor(dfB), text_size = tSize, text_halign = text.align_right, tooltip = dTip)
    row += 1

    // เทรด · Win rate (ไม้ที่ถืออยู่นับรวม เทียบราคาล่าสุด)
    nL = bookL.n + (bookL.inPos ? 1 : 0)
    nS = bookS.n + (bookS.inPos ? 1 : 0)
    winL = bookL.wins + (bookL.priceWin(close) ? 1 : 0)
    winS = bookS.wins + (bookS.priceWin(close) ? 1 : 0)
    oNL  = othL.n + (othL.inPos ? 1 : 0)
    oNS  = othS.n + (othS.inPos ? 1 : 0)
    oWL  = othL.wins + (othL.priceWin(close) ? 1 : 0)
    oWS  = othS.wins + (othS.priceWin(close) ? 1 : 0)
    table.cell(t, 0, row, 'เทรด · Win rate', text_color = muted, text_size = tSize, text_halign = text.align_left, tooltip = 'ชนะ = ราคาออกดีกว่าราคาเข้า (ไม่หัก fee) · ไม้ที่ถืออยู่เทียบราคาล่าสุด')
    table.cell(t, 1, row, str.tostring(nL) + ' · ' + wrTxt(winL, nL), text_color = muted, text_size = tSize, text_halign = text.align_right)
    table.cell(t, 2, row, str.tostring(nS) + ' · ' + wrTxt(winS, nS), text_color = muted, text_size = tSize, text_halign = text.align_right)
    table.cell(t, 3, row, str.tostring(nL + nS) + ' · ' + wrTxt(winL + winS, nL + nS), text_color = muted, text_size = tSize, text_halign = text.align_right)
    row += 1
    table.cell(t, 0, row, 'rsi.pine: เทรด · Win', text_color = muted, text_size = tSize, text_halign = text.align_left, tooltip = oTip)
    table.cell(t, 1, row, str.tostring(oNL) + ' · ' + wrTxt(oWL, oNL), text_color = muted, text_size = tSize, text_halign = text.align_right)
    table.cell(t, 2, row, str.tostring(oNS) + ' · ' + wrTxt(oWS, oNS), text_color = muted, text_size = tSize, text_halign = text.align_right)
    table.cell(t, 3, row, str.tostring(oNL + oNS) + ' · ' + wrTxt(oWL + oWS, oNL + oNS), text_color = muted, text_size = tSize, text_halign = text.align_right)
    row += 1
    table.cell(t, 0, row, 'ปิดก่อนป้าย', text_color = muted, text_size = tSize, text_halign = text.align_left, tooltip = 'ไม้ที่ปิดด้วย TP / SL / TS ก่อนป้ายตรงข้าม (นับรวมในแถวเทรดแล้ว)')
    table.cell(t, 1, row, xTxt(bookL.nTp, bookL.nSl, bookL.nTs), text_color = muted, text_size = tSize, text_halign = text.align_right)
    table.cell(t, 2, row, xTxt(bookS.nTp, bookS.nSl, bookS.nTs), text_color = muted, text_size = tSize, text_halign = text.align_right)
    table.cell(t, 3, row, xTxt(bookL.nTp + bookS.nTp, bookL.nSl + bookS.nSl, bookL.nTs + bookS.nTs), text_color = muted, text_size = tSize, text_halign = text.align_right)
    row += 1

    if showDetail
        ddL = math.max(bookL.dd, math.max(bookL.peak, eqL) - eqL)
        ddS = math.max(bookS.dd, math.max(bookS.peak, eqS) - eqS)
        ddB = math.max(bookB.dd, math.max(bookB.peak, eqB) - eqB)
        oDdB = math.max(othB.dd, math.max(othB.peak, oEqB) - oEqB)
        table.cell(t, 0, row, 'Drawdown', text_color = muted, text_size = tSize, text_halign = text.align_left, tooltip = 'ลดลงมากสุดจากจุดสูงสุดของผลรวม % · rsi.pine สองฝั่ง: ' + str.tostring(oDdB, '0.00') + '%')
        table.cell(t, 1, row, str.tostring(ddL, '0.00') + '%', text_color = muted, text_size = tSize, text_halign = text.align_right)
        table.cell(t, 2, row, str.tostring(ddS, '0.00') + '%', text_color = muted, text_size = tSize, text_halign = text.align_right)
        table.cell(t, 3, row, str.tostring(ddB, '0.00') + '%', text_color = muted, text_size = tSize, text_halign = text.align_right, tooltip = 'rsi.pine: ' + str.tostring(oDdB, '0.00') + '%')
        row += 1

    // สถานะไม้ที่ถืออยู่ + ค่า StochRSI / MACD ล่าสุดของ TF ป้าย
    openL = bookL.pnlAt(close)
    openS = bookS.pnlAt(close)
    stL = bookL.inPos ? '▲ ถือ Long' + levelTxt(bookL) + ' · เข้า ' + str.tostring(bookL.entry, format.mintick) + ' · ' + fmtPct(openL) : '▲ Long ว่าง'
    stS = bookS.inPos ? '▼ ถือ Short' + levelTxt(bookS) + ' · เข้า ' + str.tostring(bookS.entry, format.mintick) + ' · ' + fmtPct(openS) : '▼ Short ว่าง'
    stTxt = showMode == 'Long' ? stL : showMode == 'Short' ? stS : stL + '\n' + stS
    table.cell(t, 0, row, stTxt, text_color = bookL.inPos ? pnlColor(openL) : bookS.inPos ? pnlColor(openS) : muted, text_size = tSize, text_halign = text.align_left)
    table.merge_cells(t, 0, row, 3, row)
    row += 1
    indTxt = 'K ' + str.tostring(kH, '0.0') + ' · D ' + str.tostring(dH, '0.0') + ' · MACD hist ' + (hH > 0 ? '+' : '') + str.tostring(hH, format.mintick) + (biasOn ? ' · 1D ' + (dBias == 1 ? 'ขาขึ้น' : dBias == -1 ? 'ขาลง' : '—') : '')
    table.cell(t, 0, row, indTxt, text_color = muted, text_size = tSize, text_halign = text.align_left, tooltip = 'ค่าล่าสุดของ TF ป้าย (' + sigTf + ') · BUY เมื่อ K ตัดขึ้น ' + str.tostring(loV, '#') + (confV ? ' และ hist > 0' : '') + ' · SELL เมื่อ K ตัดลง ' + str.tostring(hiV, '#') + (confV ? ' และ hist < 0' : ''))
    table.merge_cells(t, 0, row, 3, row)

//-----------------------------------------------------------------------------}
//Alerts
//-----------------------------------------------------------------------------{
alertcondition(buyMark, 'BUY', 'BUY {{ticker}} ({{interval}}) | StochRSI + MACD @ {{close}}')
alertcondition(sellMark, 'SELL', 'SELL {{ticker}} ({{interval}}) | StochRSI + MACD @ {{close}}')
alertcondition((showL and xL == 1) or (showS and xS == 1), 'TP', 'TP {{ticker}} ({{interval}}) | ปิดทำกำไรก่อนป้าย')
alertcondition((showL and xL == -1) or (showS and xS == -1), 'SL', 'SL {{ticker}} ({{interval}}) | ปิดตัดขาดทุนก่อนป้าย')
alertcondition((showL and xL == 2) or (showS and xS == 2), 'TS', 'TS {{ticker}} ({{interval}}) | ปิดด้วย trailing @ {{close}}')

exitName(int x) => x == 1 ? '🎯 TP' : x == -1 ? '🛑 SL' : '📉 TS'
pre = ' ' + syminfo.ticker + ' (' + timeframe.period + ') | '
if buyMark
    alert('🟢 BUY' + pre + (showL and openedL ? 'เปิด Long @ ' + str.tostring(close, format.mintick) + levelTxt(bookL) : '') + (showS and closedS ? (showL and openedL ? ' · ' : '') + 'ปิด Short @ ' + str.tostring(close, format.mintick) : '') + ' · K ' + str.tostring(kH, '0.0'), alert.freq_once_per_bar_close)
if sellMark
    alert('🔴 SELL' + pre + (showS and openedS ? 'เปิด Short @ ' + str.tostring(close, format.mintick) + levelTxt(bookS) : '') + (showL and closedL ? (showS and openedS ? ' · ' : '') + 'ปิด Long @ ' + str.tostring(close, format.mintick) : '') + ' · K ' + str.tostring(kH, '0.0'), alert.freq_once_per_bar_close)
if showL and xL != 0
    alert(exitName(xL) + ' Long' + pre + 'ปิด Long ก่อนป้าย @ ' + str.tostring(bookL.xPx, format.mintick), alert.freq_once_per_bar_close)
if showS and xS != 0
    alert(exitName(xS) + ' Short' + pre + 'ปิด Short ก่อนป้าย @ ' + str.tostring(bookS.xPx, format.mintick), alert.freq_once_per_bar_close)

//-----------------------------------------------------------------------------}
