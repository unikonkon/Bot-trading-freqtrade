// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
// EMA Cross V2 + ตัวกรอง (ema_v2_filtered) — โหมด "เปิดแท่งถัดไป" (next_open) เท่านั้น
// ต้นฉบับ: lib/indicators-v2.ts → emaV2() + applyTradeFilter()   ตัวจำลอง: signal-bot/web ui/engine.ts → simulateNextOpen()
// ───────────────────────────────────────────────────────────────────────────────
// ลำดับการทำงาน (ตรงกับ TS ทุกขั้น)
//   ชั้น 1  เจตนาดิบ (emaV2.signal)
//           BUY  = EMA(fast) ตัดขึ้นเหนือ EMA(slow)  และ  close > EMA(fast)
//           SELL = EMA(fast) ตัดลงใต้ EMA(slow)          (ไม่บังคับเงื่อนไขราคา)
//   ชั้น 2  state machine ของตัวกรอง (applyTradeFilter, entryStyle = "trend") ทำที่ "ปิดแท่ง"
//           ถ้าถือสถานะอยู่ → ตรวจการออกก่อน ตามลำดับ
//               (ก) close <= stop          (stop = trailing ATR เลื่อนขึ้นอย่างเดียว)
//               (ข) เจอ SELL ดิบ (EMA ตัดลง)
//               (ค) ถือครบ maxHoldBars แท่ง
//           ถ้าว่าง และเจอ BUY ดิบ → ต้องผ่านครบทุกข้อ
//               0. พ้นช่วงพัก cooldown หลังออก
//               1. close > EMA เทรนด์ (100)
//               2. EMA เทรนด์ > EMA เทรนด์ เมื่อ slopeBars แท่งก่อน (ชันขึ้น)
//               3. ADX >= threshold  และ  +DI > −DI
//               4. ATR(14) / ATR(56) <= maxVolRatio (ความผันผวนไม่พุ่งผิดปกติ)
//           stop เริ่มต้น = close − max(stopAtr × ATR, close × minStopPct%)
//           trailing    = peakClose − max(trailAtr × ATR, peakClose × minStopPct%)  (ไม่ลดลง)
//   ชั้น 3  การลงมือ: สัญญาณ ณ ปิดแท่ง i → ส่งคำสั่งตลาด → fill ที่ราคา OPEN ของแท่ง i+1
//           (Pine strategy ค่าเริ่มต้น process_orders_on_close=false ทำแบบนี้พอดี)
//           Long-only Spot: BUY = เข้าซื้อเต็มพอร์ต, SELL = ปิดสถานะ (ไม่เปิด Short)
//
// ข้อสำคัญ
//   • stop ทุกตัวเทียบ "ราคาปิด" ไม่ใช่ stop order ระหว่างแท่ง — ไส้เทียนแทงลงแล้วปิดเหนือ stop ไม่ออก
//     และเมื่อออกจะ fill ที่ open แท่งถัดไป ซึ่งอาจต่ำกว่า stop ได้ถ้ามี gap
//   • EMA/RMA/ATR/DMI เขียนเองให้ตั้งต้นด้วย SMA และข้ามค่า na เหมือน lib/indicators-v2.ts ทุกบรรทัด
//     (ไม่พึ่ง ta.ema/ta.dmi เพื่อตัดความต่างเรื่อง seed/fixnan ออกทั้งหมด)
//   • ตารางกำไร/ขาดทุนคำนวณแบบเดียวกับ simulateNextOpen: เริ่ม 100 หน่วย ทบต้น
//     entry = open × (1+slip), qty = cash / (entry × (1+fee)), exit = open × (1−slip) หักค่าธรรมเนียมอีกขา
//     และบังคับปิดที่ราคาปิดแท่งสุดท้าย — ใช้ตัวเลขนี้เทียบกับเว็บ ไม่ใช่ Strategy Tester
//   • Win rate ในตาราง: ชนะ = ราคาขายสูงกว่าราคาซื้อ (Short กลับกัน) เทียบราคาตลาด ไม่หัก fee / slippage
//     ต่างจากเว็บที่นับชนะเมื่อกำไรหลังหักต้นทุน · Profit factor / Drawdown ยังคิดแบบเว็บ
//
// ตารางกำไร/ขาดทุน (รูปแบบเดียวกับ "Trendlines with Breaks [LuxAlgo] buysell-legacy.pine")
//   คอลัมน์ = 3 แบบการเทรดจากสัญญาณ BUY/SELL ชุดเดียวกัน (ลงมือที่ open แท่งถัดไปทุกแบบ)
//     ▲ Long    : BUY เปิด Long · SELL ปิด                     = ผลตอบแทน next_open ของเว็บพอดี
//     ▼ Short   : SELL เปิด Short · BUY ปิด                    ต้องใช้ Futures · ไม่รวม funding
//     ⇅ สองฝั่ง : BUY ปิด Short แล้วเปิด Long · SELL ปิด Long แล้วเปิด Short (ถือตลอดหลังสัญญาณแรก)
//     Short แบบ 1 เท่า: มูลค่า = qty × (2 × ราคาเข้า − ราคา) โดย qty คิดแบบเดียวกับ Long (กระจกของ Long)
//     ทุกคอลัมน์ทบต้นแยกกัน สองฝั่งจึงไม่เท่ากับ Long + Short (ต่างจากไฟล์ Trendlines ที่บวก % ไม่ทบต้น)
//     ข้อควรรู้: SELL ของกลยุทธ์นี้คือ "การออก" (stop / EMA ตัดลง / ถือครบ) ตัวกรองไม่ได้ตรวจขาลง
//     ฝั่ง Short จึงเป็นการถือขายช่วงที่ตัวกรองไม่อยากถือ Long ไม่ใช่สัญญาณขาลงที่ออกแบบมา
//   แถว = ผลตอบแทนย้อนจากแท่งล่าสุด 1 / 7 / 30 / 90 / 365 วัน = มูลค่าตอนนี้ ÷ มูลค่าเมื่อต้นช่วง − 1
//     มูลค่า = ถ้าปิดไม้ที่ราคาปิดแท่งนั้น (หัก slippage + ค่าธรรมเนียม เหมือนเว็บปิดไม้ตอนจบข้อมูล)
//     ช่วงที่ยาวกว่าข้อมูลจะไม่แสดง · "ทั้งหมด · N วัน" = ตั้งแต่แท่งแรกของช่วงทดสอบถึงแท่งล่าสุด
//   • Strategy Tester ของ TradingView ไม่มี slippage แบบ % จึงรวม fee 0.10% + slippage 0.05% เป็น
//     commission 0.15% ต่อขา (ค่าใกล้เคียง ต่างกันระดับ 0.001% ต่อเทรด)
// ═══════════════════════════════════════════════════════════════════════════════
strategy("EMA Cross V2 + Filter [next open]", shorttitle = "EMA V2 F", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     pyramiding = 0, commission_type = strategy.commission.percent, commission_value = 0.15,
     margin_long = 0, margin_short = 0, process_orders_on_close = false, calc_on_every_tick = false,
     max_labels_count = 500)

// ─── Inputs ───────────────────────────────────────────────────────────────────
const string G_CORE  = "EMA Cross (สัญญาณดิบ)"
const string G_FILT  = "ตัวกรองเข้า"
const string G_EXIT  = "การออก"
const string G_RANGE = "ช่วงทดสอบ"
const string G_SIM   = "ตารางจำลองแบบเว็บ (next_open)"
const string G_VIS   = "การแสดงผล"

emaFastLength      = input.int(20,  "EMA เร็ว",                 minval = 2, group = G_CORE)
emaSlowLength      = input.int(50,  "EMA ช้า",                  minval = 2, group = G_CORE)

filterTrendLength  = input.int(100, "EMA เทรนด์",               minval = 2, group = G_FILT)
filterSlopeBars    = input.int(5,   "ความชัน EMA เทรนด์ (แท่ง)", minval = 1, group = G_FILT)
filterAdxLength    = input.int(14,  "ADX / DI length",          minval = 2, group = G_FILT)
filterAdxThreshold = input.float(18, "ADX ขั้นต่ำ",              minval = 0, step = 0.5, group = G_FILT)
filterAtrLength    = input.int(14,  "ATR length (ATR ช้า = ×4)", minval = 2, group = G_FILT)
filterMaxVolRatio  = input.float(2.5, "ATR เร็ว/ATR ช้า สูงสุด", minval = 0.1, step = 0.1, group = G_FILT)
filterCooldownBars = input.int(3,   "พักหลังออก (แท่ง)",         minval = 0, group = G_FILT)

filterStopAtr      = input.float(2.5, "Stop เริ่มต้น (× ATR)",   minval = 0.1, step = 0.1, group = G_EXIT)
filterTrailAtr     = input.float(3.0, "Trailing (× ATR)",        minval = 0.1, step = 0.1, group = G_EXIT)
filterMinStopPct   = input.float(0.5, "ระยะ Stop ขั้นต่ำ (%)",    minval = 0.01, step = 0.05, group = G_EXIT)
filterMaxHoldBars  = input.int(150, "จำนวนแท่งถือสูงสุด",         minval = 2, group = G_EXIT)

useStart   = input.bool(false, "เริ่มนับสัญญาณตั้งแต่วันที่", inline = "start", group = G_RANGE,
     tooltip = "เทียบ startIndex ของเว็บ: อินดิเคเตอร์ยังคำนวณจากทุกแท่ง แต่สถานะเริ่มว่างที่วันนี้ ใส่วัน/เวลาเปิดของแท่งแรกในช่วงทดสอบของเว็บ")
startTime  = input.time(timestamp("2026-01-01T00:00:00+00:00"), "", inline = "start", group = G_RANGE)

feePct     = input.float(0.10, "ค่าธรรมเนียม/ขา (%)", minval = 0, step = 0.01, group = G_SIM)
slipPct    = input.float(0.05, "Slippage/ขา (%)",     minval = 0, step = 0.01, group = G_SIM)

showEmas     = input.bool(true,  "แสดง EMA เร็ว/ช้า/เทรนด์", group = G_VIS)
showStop     = input.bool(true,  "แสดงเส้น stop",             group = G_VIS)
showRejected = input.bool(false, "แสดง BUY ดิบที่ถูกตัวกรองปฏิเสธ (ชี้เมาส์ดูเหตุผล)", group = G_VIS)
showTable    = input.bool(true,  "แสดงตาราง",                 group = G_VIS)

const string G_TBL = "ตารางกำไร/ขาดทุน"
showFilters  = input.bool(true,  "แสดงแถวตัวกรอง",                     group = G_TBL)
showDetail   = input.bool(true,  "แสดง Profit factor / Drawdown / Buy & Hold", group = G_TBL)
tablePosIn   = input.string("Top Right", "ตำแหน่ง", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = G_TBL, inline = "tbl")
tableSize    = input.string("Normal", "ขนาด", options = ["Small", "Normal", "Large"], group = G_TBL, inline = "tbl")
buyCss       = input.color(#089981, "สีกำไร", group = G_TBL, inline = "c")
sellCss      = input.color(#F23645, "สีขาดทุน", group = G_TBL, inline = "c")

if emaFastLength >= emaSlowLength
    runtime.error("EMA เร็วต้องสั้นกว่า EMA ช้า")

// ─── ค่าเฉลี่ยแบบเดียวกับ lib/indicators-v2.ts ────────────────────────────────
// EMA: ตั้งต้นด้วย SMA ของ n ค่าแรกที่ไม่ใช่ na แล้วใช้ alpha = 2/(n+1); input na → output na
emaSeeded(float src, int len) =>
    var float prev = na
    var float seed = 0.0
    var int   seen = 0
    float out = na
    if not na(src)
        if na(prev)
            seed += src
            seen += 1
            if seen == len
                prev := seed / len
                out := prev
        else
            float alpha = 2.0 / (len + 1)
            prev := src * alpha + prev * (1 - alpha)
            out := prev
    out

// RMA (Wilder): ตั้งต้นด้วย SMA แล้ว prev = (prev × (n−1) + v) / n
rmaSeeded(float src, int len) =>
    var float prev = na
    var float seed = 0.0
    var int   seen = 0
    float out = na
    if not na(src)
        if na(prev)
            seed += src
            seen += 1
            if seen == len
                prev := seed / len
                out := prev
        else
            prev := (prev * (len - 1) + src) / len
            out := prev
    out

// ─── อินดิเคเตอร์ ─────────────────────────────────────────────────────────────
float fastEma  = emaSeeded(close, emaFastLength)
float slowEma  = emaSeeded(close, emaSlowLength)
float trendEma = emaSeeded(close, filterTrendLength)

// True Range: แท่งแรกใช้ High−Low (trueRange ใน TS)
float trAll = bar_index == 0 ? high - low : math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
float atrFast = rmaSeeded(trAll, filterAtrLength)
float atrSlow = rmaSeeded(trAll, filterAtrLength * 4)

// DMI แบบ Wilder: แท่งแรกไม่มี TR/DM เทียบแท่งก่อน จึงเป็น na (dmi ใน TS)
float upMove   = high - high[1]
float downMove = low[1] - low
float plusDM   = bar_index == 0 ? na : (upMove > downMove and upMove > 0 ? upMove : 0.0)
float minusDM  = bar_index == 0 ? na : (downMove > upMove and downMove > 0 ? downMove : 0.0)
float trDmi    = bar_index == 0 ? na : trAll
float trR      = rmaSeeded(trDmi, filterAdxLength)
float plusR    = rmaSeeded(plusDM, filterAdxLength)
float minusR   = rmaSeeded(minusDM, filterAdxLength)
bool  dmiOk    = not na(trR) and not na(plusR) and not na(minusR) and trR != 0
float plusDI   = dmiOk ? 100 * plusR / trR : na
float minusDI  = dmiOk ? 100 * minusR / trR : na
float diSum    = plusDI + minusDI
float dx       = dmiOk ? (diSum == 0 ? 0.0 : 100 * math.abs(plusDI - minusDI) / diSum) : na
float adx      = rmaSeeded(dx, filterAdxLength)

// ─── ชั้น 1: เจตนาดิบของ EMA Cross V2 ────────────────────────────────────────
bool emaReady  = not na(fastEma) and not na(slowEma) and not na(fastEma[1]) and not na(slowEma[1])
bool crossUp   = emaReady and fastEma[1] <= slowEma[1] and fastEma > slowEma
bool crossDown = emaReady and fastEma[1] >= slowEma[1] and fastEma < slowEma
int  intent    = crossUp and close > fastEma ? 1 : crossDown ? -1 : 0

// ─── ชั้น 2: state machine ของตัวกรอง (ทำเฉพาะแท่งที่ปิดแล้ว) ────────────────
var bool  active        = false
var bool  inPos         = false
var int   entryBar      = 0
var float peakClose     = 0.0
var float curStop       = 0.0
var int   cooldownUntil = -1

// เริ่มสถานะว่างที่ startIndex ครั้งเดียว แล้วเดินต่อไปตลอด (เหมือน loop i = startIndex..len−1)
if not active and (not useStart or time >= startTime)
    active := true

int    sig        = 0      // 1 = BUY, -1 = SELL
int    exitKind   = 0      // 1 = stop, 2 = EMA ตัดลง, 3 = ถือครบ
string reasonText = ""
bool   rejected   = false
float  stopPlot   = na
int    slopeBars  = filterSlopeBars

if active and barstate.isconfirmed
    if inPos
        peakClose := math.max(peakClose, close)
        if not na(atrFast)
            float trail = math.max(filterTrailAtr * atrFast, peakClose * filterMinStopPct / 100)
            curStop := math.max(curStop, peakClose - trail)
        stopPlot := curStop
        int held = bar_index - entryBar
        if close <= curStop
            sig := -1
            exitKind := 1
            reasonText := "ออก: ราคาปิด " + str.tostring(close, format.mintick) + " ≤ stop " + str.tostring(curStop, format.mintick)
        else if intent == -1
            sig := -1
            exitKind := 2
            reasonText := "ออก: EMA เร็วตัดลงใต้ EMA ช้า"
        else if held >= filterMaxHoldBars
            sig := -1
            exitKind := 3
            reasonText := "ออก: ถือครบ " + str.tostring(held) + " แท่ง"
        if sig == -1
            inPos := false
            cooldownUntil := bar_index + filterCooldownBars
    else if intent == 1
        float tePrev = trendEma[slopeBars]
        rejected := true
        if bar_index < cooldownUntil
            reasonText := "งดเข้า: อยู่ในช่วงพักหลังออก"
        else if na(trendEma) or na(tePrev) or na(adx) or na(plusDI) or na(minusDI) or na(atrFast) or na(atrSlow)
            reasonText := "งดเข้า: ข้อมูลยังไม่พอสำหรับตัวกรอง"
        else if close <= trendEma
            reasonText := "งดเข้า: ราคาปิดต่ำกว่า EMA เทรนด์"
        else if trendEma <= tePrev
            reasonText := "งดเข้า: EMA เทรนด์ไม่ได้สูงขึ้นเทียบ " + str.tostring(slopeBars) + " แท่งก่อน"
        else if adx < filterAdxThreshold
            reasonText := "งดเข้า: ADX " + str.tostring(adx, "#.0") + " ต่ำกว่าเกณฑ์"
        else if plusDI <= minusDI
            reasonText := "งดเข้า: +DI ไม่เหนือ −DI"
        else if atrSlow > 0 and atrFast / atrSlow > filterMaxVolRatio
            reasonText := "งดเข้า: ความผันผวนพุ่งผิดปกติ"
        else
            rejected := false
            inPos := true
            entryBar := bar_index
            peakClose := close
            curStop := close - math.max(filterStopAtr * atrFast, close * filterMinStopPct / 100)
            stopPlot := curStop
            sig := 1
            reasonText := "เข้า: สัญญาณดิบผ่านตัวกรองครบ (ADX " + str.tostring(adx, "#.0") + ")"

// ─── ชั้น 3: ส่งคำสั่ง — fill ที่ open แท่งถัดไป ─────────────────────────────
if sig == 1
    strategy.entry("Long", strategy.long, comment = "BUY")
    alert('{"signal":"BUY","symbol":"' + syminfo.tickerid + '","tf":"' + timeframe.period +
         '","close":' + str.tostring(close) + ',"stop":' + str.tostring(curStop) + '}', alert.freq_once_per_bar_close)
if sig == -1
    string exitTag = exitKind == 1 ? "SELL stop" : exitKind == 2 ? "SELL cross" : "SELL time"
    strategy.close("Long", comment = exitTag)
    alert('{"signal":"SELL","symbol":"' + syminfo.tickerid + '","tf":"' + timeframe.period +
         '","close":' + str.tostring(close) + ',"reason":"' + exitTag + '"}', alert.freq_once_per_bar_close)

// ─── การแสดงผล ────────────────────────────────────────────────────────────────
plot(showEmas ? fastEma : na,  "EMA เร็ว",   color.new(color.aqua, 0),   1)
plot(showEmas ? slowEma : na,  "EMA ช้า",    color.new(color.orange, 0), 2)
plot(showEmas ? trendEma : na, "EMA เทรนด์", color.new(color.gray, 30),  2)
plot(showStop ? stopPlot : na, "Stop (เทียบราคาปิด)", color.new(color.red, 0), 1, plot.style_linebr)

plotshape(sig == 1,                      "BUY",        shape.labelup,   location.belowbar, color.new(color.green, 0), text = "BUY",        textcolor = color.white, size = size.small)
plotshape(sig == -1 and exitKind == 2,   "SELL cross", shape.labeldown, location.abovebar, color.new(color.red, 0),   text = "SELL",       textcolor = color.white, size = size.small)
plotshape(sig == -1 and exitKind == 1,   "SELL stop",  shape.labeldown, location.abovebar, color.new(color.maroon, 0), text = "SELL\nstop", textcolor = color.white, size = size.small)
plotshape(sig == -1 and exitKind == 3,   "SELL time",  shape.labeldown, location.abovebar, color.new(color.purple, 0), text = "SELL\ntime", textcolor = color.white, size = size.small)

if showRejected and rejected
    label.new(bar_index, low, "×", style = label.style_label_up, color = color.new(color.gray, 60),
         textcolor = color.white, size = size.tiny, tooltip = reasonText)

bgcolor(inPos ? color.new(color.green, 94) : na, title = "กำลังถือสถานะ")

// ─── จำลองแบบเว็บ (simulateNextOpen) · 3 บัญชี: Long / Short / สองฝั่ง ─────────────
// action ของแท่ง i = สัญญาณของแท่ง i−1 → ลงมือที่ open แท่ง i · ทุกบัญชีเริ่ม 100 หน่วยและทบต้นแยกกัน
float fee = feePct / 100
float slip = slipPct / 100
int prevSig = nz(sig[1])

type Sim
    float cash     = 100.0
    float qty      = 0.0
    int   dir      = 0        // 1 ถือ Long · −1 ถือ Short · 0 ว่าง
    float entry    = na       // ราคาเข้าหลัง slippage
    float px0      = na       // ราคาตลาดตอนเข้า (open ก่อน slippage) ใช้ตัดสินชนะ/แพ้
    float invested = 0.0
    float peak     = 100.0
    float dd       = 0.0
    float peakPrev = 100.0
    float ddPrev   = 0.0
    int   n        = 0
    int   wins     = 0
    float gain     = 0.0
    float loss     = 0.0

// มูลค่าแบบเว็บ (equity รายแท่ง): Long = qty × ราคา · Short = qty × (2 × entry − ราคา) · ไม่หักต้นทุนขาออก
method mark(Sim s, float p) =>
    s.dir == 0 ? s.cash : s.dir == 1 ? s.qty * p : math.max(0.0, s.qty * (2 * s.entry - p))

// มูลค่าถ้าปิดที่ราคา p ตอนนี้ (หัก slippage + ค่าธรรมเนียม) = สิ่งที่เว็บทำตอนจบข้อมูล
method liq(Sim s, float p) =>
    s.dir == 0 ? s.cash : s.dir == 1 ? s.qty * p * (1 - slip) * (1 - fee) : math.max(0.0, s.qty * (2 * s.entry - p * (1 + slip))) * (1 - fee)

// ผลของไม้ที่ถืออยู่ถ้าปิดที่ราคา p (%)
method openPnl(Sim s, float p) =>
    s.dir == 0 ? 0.0 : (s.liq(p) / s.invested - 1) * 100

// ชนะ/แพ้ตัดสินจากราคาเท่านั้น (ไม่หัก fee / slippage): Long ชนะเมื่อราคาขาย > ราคาซื้อ · Short ชนะเมื่อราคาซื้อคืน < ราคาขาย
method priceWin(Sim s, float p) =>
    s.dir != 0 and s.dir * (p - s.px0) > 0

method openPos(Sim s, int d, float p) =>
    s.invested := s.cash
    s.px0      := p
    s.entry    := d == 1 ? p * (1 + slip) : p * (1 - slip)
    s.qty      := s.cash / (s.entry * (1 + fee))
    s.cash     := 0.0
    s.dir      := d

method closePos(Sim s, float p) =>
    float pnl = s.openPnl(p)
    bool  win = s.priceWin(p)
    s.cash := s.liq(p)
    s.qty  := 0.0
    s.dir  := 0
    s.n    := s.n + 1
    if win
        s.wins := s.wins + 1
    if pnl > 0
        s.gain := s.gain + pnl
    else
        s.loss := s.loss - pnl

// อัปเดต drawdown จากมูลค่ารายแท่ง (เก็บค่าก่อนหน้าไว้ เพราะแท่งสุดท้ายเว็บใช้มูลค่าหลังบังคับปิด)
method track(Sim s, float p) =>
    s.peakPrev := s.peak
    s.ddPrev   := s.dd
    float v = s.mark(p)
    s.peak := math.max(s.peak, v)
    s.dd   := math.max(s.dd, (s.peak - v) / s.peak * 100)

var Sim simL = Sim.new()
var Sim simS = Sim.new()
var Sim simB = Sim.new()

var bool  simStarted    = false
var float simStartClose = na
var int   windowStartT  = na

if active
    if not simStarted
        // แท่งแรกของช่วงทดสอบ action = HOLD เสมอ (ไม่พาคำสั่งค้างจาก warm-up)
        simStarted    := true
        simStartClose := close
        windowStartT  := time
    else if prevSig == 1
        if simS.dir == -1
            simS.closePos(open)            // BUY: ปิด Short
        if simL.dir == 0
            simL.openPos(1, open)          //      เปิด Long
        if simB.dir == -1
            simB.closePos(open)            // สองฝั่ง: ปิด Short แล้วเปิด Long
        if simB.dir == 0
            simB.openPos(1, open)
    else if prevSig == -1
        if simL.dir == 1
            simL.closePos(open)            // SELL: ปิด Long
        if simS.dir == 0
            simS.openPos(-1, open)         //       เปิด Short
        if simB.dir == 1
            simB.closePos(open)            // สองฝั่ง: ปิด Long แล้วเปิด Short
        if simB.dir == 0
            simB.openPos(-1, open)
    simL.track(close)
    simS.track(close)
    simB.track(close)

// มูลค่าถ้าปิดทุกไม้ ณ ราคาปิดของแต่ละแท่ง — ใช้หาผลตอบแทนย้อนหลังรายช่วง
var array<int>   eqTime = array.new<int>()
var array<float> eqL    = array.new<float>()
var array<float> eqS    = array.new<float>()
var array<float> eqB    = array.new<float>()
if active and barstate.isconfirmed
    eqTime.push(time_close)
    eqL.push(simL.liq(close))
    eqS.push(simS.liq(close))
    eqB.push(simB.liq(close))

// ดัชนีสุดท้ายที่ค่า ≤ t (อาเรย์เรียงจากน้อยไปมาก) · −1 = ไม่มี
lastAtOrBefore(array<int> a, int t) =>
    int lo  = 0
    int hi  = a.size() - 1
    int ans = -1
    while lo <= hi
        int mid = math.floor((lo + hi) / 2)
        if a.get(mid) <= t
            ans := mid
            lo  := mid + 1
        else
            hi  := mid - 1
    ans

// ─── ตารางกำไร/ขาดทุน: แถว = ช่วงเวลา · คอลัมน์ = แบบการเทรด ──────────────────────
fmtPct(float x) => (x > 0 ? "+" : "") + str.tostring(x, "0.00") + "%"
pnlColor(float x) => x > 0.005 ? buyCss : x < -0.005 ? sellCss : color.gray
mk(bool ok) => ok ? "✓" : "✗"
// ผลตอบแทนตอนนี้เทียบมูลค่าเมื่อต้นช่วง (ก่อนเริ่มทดสอบ = 100 หน่วย)
retSince(float nowV, array<float> vals, int idx) => (nowV / (idx >= 0 ? vals.get(idx) : 100.0) - 1) * 100
// Win rate / PF / Drawdown รวมไม้ที่ถืออยู่ (บังคับปิดที่ราคาล่าสุดเหมือนเว็บ)
// Win rate ตัดสินจากราคา (ไม่หัก fee / slippage) · PF / Drawdown ยังหักต้นทุนแบบเว็บ
winText(Sim s, float p) =>
    int   n = s.n + (s.dir != 0 ? 1 : 0)
    int   w = s.wins + (s.priceWin(p) ? 1 : 0)
    n > 0 ? str.tostring(w * 100.0 / n, "0.0") + "%" : "—"
ddText(Sim s, float p) =>
    float endV = s.liq(p)
    float pk   = math.max(s.peakPrev, endV)
    str.tostring(math.max(s.ddPrev, (pk - endV) / pk * 100), "0.00") + "%"
// Profit factor = กำไรรวม ÷ ขาดทุนรวม (% ต่อไม้) แบบเดียวกับเว็บ
pfText(Sim s, float p) =>
    float op = s.dir != 0 ? s.openPnl(p) : 0.0
    float g  = s.gain + (op > 0 ? op : 0.0)
    float l  = s.loss + (s.dir != 0 and op <= 0 ? -op : 0.0)
    l > 0 ? str.tostring(g / l, "0.00") : g > 0 ? "∞" : "—"

if showTable and barstate.islast and simStarted
    tPos  = tablePosIn == "Top Left" ? position.top_left : tablePosIn == "Bottom Right" ? position.bottom_right : tablePosIn == "Bottom Left" ? position.bottom_left : position.top_right
    tSize = tableSize == "Small" ? size.small : tableSize == "Large" ? size.large : size.normal
    bg    = color.new(#131722, 10)
    muted = color.new(color.white, 45)
    band  = color.new(color.white, 92)
    var table t = table.new(tPos, 4, 15, bgcolor = bg, frame_color = color.new(color.white, 85), frame_width = 1)
    table.clear(t, 0, 0, 3, 14)

    // หัวตาราง
    table.cell(t, 0, 0, syminfo.ticker + " · " + timeframe.period + " · next open", text_color = color.white, text_size = tSize, text_halign = text.align_left)
    table.merge_cells(t, 0, 0, 2, 0)
    table.cell(t, 3, 0, "fee " + str.tostring(feePct, "0.00") + "% · slip " + str.tostring(slipPct, "0.00") + "%", text_color = muted, text_size = tSize, text_halign = text.align_right, tooltip = "ต่อขา · ทบต้นเริ่ม 100 หน่วยแบบเดียวกับเว็บ (simulateNextOpen) · ไม่รวม funding")
    table.cell(t, 0, 1, "ช่วง", text_color = muted, text_size = tSize, text_halign = text.align_left)
    table.cell(t, 1, 1, "▲ Long", text_color = muted, text_size = tSize, text_halign = text.align_right, tooltip = "BUY เปิด Long · SELL ปิด (Spot) — ตรงกับผล next_open ของเว็บ")
    table.cell(t, 2, 1, "▼ Short", text_color = muted, text_size = tSize, text_halign = text.align_right, tooltip = "SELL เปิด Short · BUY ปิด (ต้องใช้ Futures · ไม่รวม funding)\nSELL ของกลยุทธ์นี้คือการออก (stop / EMA ตัดลง / ถือครบ) ไม่ใช่สัญญาณขาลงที่ผ่านตัวกรอง")
    table.cell(t, 3, 1, "⇅ สองฝั่ง", text_color = muted, text_size = tSize, text_halign = text.align_right, tooltip = "BUY ปิด Short แล้วเปิด Long · SELL ปิด Long แล้วเปิด Short\nทบต้นในบัญชีเดียว จึงไม่เท่ากับ Long + Short")

    // ระยะเวลาที่คำนวณได้จริง: แท่งแรกของช่วงทดสอบ → แท่งล่าสุด
    nowT    = math.min(time_close, timenow)
    fromT   = nz(windowStartT, nowT)
    totalMs = nowT - fromT
    DAY_MS  = 86400000
    nowL    = simL.liq(close)
    nowS    = simS.liq(close)
    nowB    = simB.liq(close)

    // 1 วัน · 1 สัปดาห์ · 1 เดือน · 3 เดือน · 1 ปี — ย้อนจากแท่งล่าสุด · แสดงเฉพาะช่วงที่ข้อมูลยาวพอ
    names = array.from("1 วัน", "1 สัปดาห์", "1 เดือน", "3 เดือน", "1 ปี")
    spans = array.from(1, 7, 30, 90, 365)
    int row = 2
    for i = 0 to 4
        spanMs = spans.get(i) * DAY_MS
        if spanMs <= totalMs
            idx  = lastAtOrBefore(eqTime, nowT - spanMs)
            chgL = retSince(nowL, eqL, idx)
            chgS = retSince(nowS, eqS, idx)
            chgB = retSince(nowB, eqB, idx)
            table.cell(t, 0, row, names.get(i), text_color = color.white, text_size = tSize, text_halign = text.align_left, tooltip = "ย้อน " + str.tostring(spans.get(i)) + " วันจากแท่งล่าสุด")
            table.cell(t, 1, row, fmtPct(chgL), text_color = pnlColor(chgL), text_size = tSize, text_halign = text.align_right)
            table.cell(t, 2, row, fmtPct(chgS), text_color = pnlColor(chgS), text_size = tSize, text_halign = text.align_right)
            table.cell(t, 3, row, fmtPct(chgB), text_color = pnlColor(chgB), text_size = tSize, text_halign = text.align_right)
            row += 1

    // ทั้งหมด + จำนวนวัน (Long = ผลตอบแทน next_open ของเว็บ · ไม้ที่ถืออยู่บังคับปิดที่ราคาล่าสุด)
    totL     = nowL - 100
    totS     = nowS - 100
    totB     = nowB - 100
    days     = math.floor(totalMs / DAY_MS)
    allLabel = "ทั้งหมด · " + (days >= 1 ? str.tostring(days) + " วัน" : str.tostring(math.floor(totalMs / 3600000)) + " ชม.")
    allTip   = str.format_time(fromT, "dd MMM yyyy HH:mm", "Asia/Bangkok") + " → " + str.format_time(nowT, "dd MMM yyyy HH:mm", "Asia/Bangkok") + " (เวลาไทย)\nเริ่มนับจากแท่งแรกของช่วงทดสอบ (วันที่เริ่มนับ หรือแท่งแรกของกราฟ)"
    table.cell(t, 0, row, allLabel, text_color = color.white, text_size = tSize, text_halign = text.align_left, bgcolor = band, tooltip = allTip)
    table.cell(t, 1, row, fmtPct(totL), text_color = pnlColor(totL), text_size = tSize, text_halign = text.align_right, bgcolor = band)
    table.cell(t, 2, row, fmtPct(totS), text_color = pnlColor(totS), text_size = tSize, text_halign = text.align_right, bgcolor = band)
    table.cell(t, 3, row, fmtPct(totB), text_color = pnlColor(totB), text_size = tSize, text_halign = text.align_right, bgcolor = band)
    row += 1

    // จำนวนเทรด (ปิดแล้ว + ถืออยู่)
    nL = simL.n + (simL.dir != 0 ? 1 : 0)
    nS = simS.n + (simS.dir != 0 ? 1 : 0)
    nB = simB.n + (simB.dir != 0 ? 1 : 0)
    table.cell(t, 0, row, "เทรด", text_color = muted, text_size = tSize, text_halign = text.align_left)
    table.cell(t, 1, row, str.tostring(nL), text_color = muted, text_size = tSize, text_halign = text.align_right)
    table.cell(t, 2, row, str.tostring(nS), text_color = muted, text_size = tSize, text_halign = text.align_right)
    table.cell(t, 3, row, str.tostring(nB), text_color = muted, text_size = tSize, text_halign = text.align_right)
    row += 1

    // Win rate จากราคา (ขายสูงกว่าซื้อ = ชนะ · ไม่หัก fee / slippage) — ไม้ที่ถืออยู่เทียบราคาล่าสุด
    table.cell(t, 0, row, "Win rate", text_color = color.white, text_size = tSize, text_halign = text.align_left, tooltip = "ชนะ = ราคาขายสูงกว่าราคาซื้อ (Short: ซื้อคืนต่ำกว่าราคาที่ขาย) · เท่าเดิมหรือแย่กว่า = แพ้\nเทียบราคาตลาด (open ที่ลงมือ) อย่างเดียว ไม่หักค่าธรรมเนียม/slippage จึงอาจสูงกว่า Win rate บนเว็บ\nไม้ที่ถืออยู่เทียบกับราคาล่าสุด")
    table.cell(t, 1, row, winText(simL, close), text_color = color.white, text_size = tSize, text_halign = text.align_right)
    table.cell(t, 2, row, winText(simS, close), text_color = color.white, text_size = tSize, text_halign = text.align_right)
    table.cell(t, 3, row, winText(simB, close), text_color = color.white, text_size = tSize, text_halign = text.align_right)
    row += 1

    // Profit factor · Drawdown · Buy & Hold (ปิดได้ใน input)
    if showDetail
        table.cell(t, 0, row, "Profit factor", text_color = muted, text_size = tSize, text_halign = text.align_left, tooltip = "กำไรรวม ÷ ขาดทุนรวม · มากกว่า 1 = ได้มากกว่าเสีย")
        table.cell(t, 1, row, pfText(simL, close), text_color = muted, text_size = tSize, text_halign = text.align_right)
        table.cell(t, 2, row, pfText(simS, close), text_color = muted, text_size = tSize, text_halign = text.align_right)
        table.cell(t, 3, row, pfText(simB, close), text_color = muted, text_size = tSize, text_halign = text.align_right)
        table.cell(t, 0, row + 1, "Drawdown", text_color = muted, text_size = tSize, text_halign = text.align_left, tooltip = "ลดลงมากสุดจากจุดสูงสุดของมูลค่าพอร์ต (%) แบบเดียวกับเว็บ")
        table.cell(t, 1, row + 1, ddText(simL, close), text_color = muted, text_size = tSize, text_halign = text.align_right)
        table.cell(t, 2, row + 1, ddText(simS, close), text_color = muted, text_size = tSize, text_halign = text.align_right)
        table.cell(t, 3, row + 1, ddText(simB, close), text_color = muted, text_size = tSize, text_halign = text.align_right)
        float bh = (close / simStartClose - 1) * 100
        table.cell(t, 0, row + 2, "Buy & Hold", text_color = muted, text_size = tSize, text_halign = text.align_left, tooltip = "ถือตั้งแต่ราคาปิดแท่งแรกของช่วงทดสอบถึงราคาปิดล่าสุด (ไม่หักค่าธรรมเนียม) เหมือนเว็บ")
        table.cell(t, 1, row + 2, fmtPct(bh), text_color = pnlColor(bh), text_size = tSize, text_halign = text.align_right)
        table.merge_cells(t, 1, row + 2, 3, row + 2)
        row += 3

    // สถานะ: สัญญาณของแท่งล่าสุดจะลงมือที่ open แท่งถัดไป
    oL = simL.openPnl(close)
    oS = simS.openPnl(close)
    string status = sig == 1 ? "⏳ BUY · เข้าที่ open แท่งถัดไป" : sig == -1 ? "⏳ SELL · ออกที่ open แท่งถัดไป" : simL.dir == 1 ? "▲ ถือ Long · เข้า " + str.tostring(simL.entry, format.mintick) + " · stop " + str.tostring(curStop, format.mintick) + " · " + fmtPct(oL) : simS.dir == -1 ? "▼ ถือ Short · เข้า " + str.tostring(simS.entry, format.mintick) + " · " + fmtPct(oS) : "○ ว่าง · รอ BUY"
    color stCol = sig != 0 ? color.yellow : simL.dir == 1 ? pnlColor(oL) : simS.dir == -1 ? pnlColor(oS) : muted
    table.cell(t, 0, row, status, text_color = stCol, text_size = tSize, text_halign = text.align_left, tooltip = "Long ถือหลัง BUY · Short ถือหลัง SELL · สองฝั่งถือฝั่งเดียวกับสัญญาณล่าสุด · stop เทียบราคาปิด")
    table.merge_cells(t, 0, row, 3, row)
    row += 1

    // ตัวกรองของแท่งล่าสุด (ถ้าเกิด BUY ดิบตอนนี้ จะผ่านข้อไหนบ้าง)
    if showFilters
        bool trendOk = close > trendEma
        bool slopeOk = trendEma > trendEma[slopeBars]
        bool adxOk   = adx >= filterAdxThreshold and plusDI > minusDI
        float volR   = atrSlow > 0 ? atrFast / atrSlow : 0.0
        bool volOk   = volR <= filterMaxVolRatio
        string ftxt  = "ตัวกรอง  เทรนด์ " + mk(trendOk) + " · ชัน " + mk(slopeOk) + " · ADX " + str.tostring(adx, "0.0") + " " + mk(adxOk) + " · ATR " + str.tostring(volR, "0.00") + " " + mk(volOk)
        bool allOk   = trendOk and slopeOk and adxOk and volOk
        table.cell(t, 0, row, ftxt, text_color = allOk ? buyCss : muted, text_size = tSize, text_halign = text.align_left, tooltip = "เงื่อนไขเข้าของแท่งล่าสุด: close > EMA เทรนด์ · EMA เทรนด์ชันขึ้น · ADX ≥ เกณฑ์และ +DI > −DI · ATR เร็ว/ช้า ≤ เกณฑ์\nเขียวเมื่อผ่านครบ (ยังต้องรอ EMA เร็วตัดขึ้นจึงเกิด BUY)")
        table.merge_cells(t, 0, row, 3, row)
